!----------CHARMM input example--------------------------------------------------
! generate STAP potential energy function

MOD
ROTS

ASSIGN sele segid PRO0 .and. resid  58 .and. type C end -
       sele segid PRO0 .and. resid  59 .and. type N end -
       sele segid PRO0 .and. resid  59 .and. type CA end -
       sele segid PRO0 .and. resid  59 .and. type C end -
       sele segid PRO0 .and. resid  59 .and. type N end -
       sele segid PRO0 .and. resid  59 .and. type CA end -
       sele segid PRO0 .and. resid  59 .and. type C end -
       sele segid PRO0 .and. resid  60 .and. type N end -

! set force constant and Max/Min/Int of position
FORC 1 NPOS 33 -
XMIN -240.00000 XMAX 240.00000 XINT 15.000000 -
YMIN -240.00000 YMAX 240.00000 YINT 15.000000 -
POS -
5.8497820  5.8497820  5.8497820  5.8497820  5.8497820  5.8497820 -
5.8497820  5.8497820  5.8497820  5.8497820  5.8497820  5.8497820 -
.
.
.
.

end
return

