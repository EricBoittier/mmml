* CHARMM 36 testcase csatest.inp
* Test the CSA module
* Author: Milan Hodoscek
* the system obtained from:
* Wikipedia: tetrapeptide -> the first on the list
*

if ?distene .ne. 1 then
 echo "csatest.inp> Test NOT performed."
 stop
endif

stream datadir.def

open read unit 1 card name @0top_all22_prot.inp
read rtf unit 1 card

open read unit 1 card name @0par_all22_prot.inp
read param unit 1 card

read sequ card
* tuftsin
    4
thr lys pro arg

generate tuft setup

! scratch/tuftsin.cor isn't created anywhere in this test or its
! callee csamin.str -- both just read it.  The scratch dir is wiped
! by test.com between tests, so even a hypothetical earlier creator
! wouldn't help.  Self-skip when the file is missing rather than
! aborting at BOMLEV 0 from <OPNLGU>'s "OPEN not possible" warning.
! Same shape as the c47test/nanomaterial.inp data-file fix.
! Surfaced by pipeline-dev #29 on the misc2 config.
bomlev -2
open unit 98 read form name @9tuftsin.cor
if ?iostat .ne. 1 then
   bomlev 0
   echo "Test NOT performed. scratch/tuftsin.cor not available."
   stop
endif
close unit 98
bomlev 0
open read unit 1 card name @9tuftsin.cor
read coor card unit 1

ener cdie inbfrq 25 cutnb 14.0 ctofnb 12.0 fshift vshift -
     wmin 1.5 e14fac 0.4 atom

open read file unit 50 name @9tuftsin.dcd

master nsubs 10 program "../bin/charmm" -
       nproc 1 input "@0/csamin.str" output "output/tuftmin.out"

etraj firstu 50 nunit 1 skip 1000 begin 21000 stop 1020000

stop
