* CHARMM 31 testcase sccgsbp2_ca.inp
* .Test SCCGSBP, the QM/MM approach using SCC-DFTB and GSBP for CA
* .partition the system in preparation for dynamics
* .Author:  P. Schaefer, Univ. Wisc. Madison    June 2004
*

IF ?SCCDFTB .NE. 1 THEN
 echo "c32test/sccgsbp2_2cba> SCCDFTB Test NOT performed."
 STOP
endif

IF ?QGSBP .NE. 1 THEN
 echo "c32test/sccgsbp2_2cba> GSBP Test NOT performed."
 STOP
endif

bomb -5

! variables
stream datadir.def

! SCC-DFTB needs SCCDFTB_DATA pointing at a directory holding this test's
! parameter file.  `genv' on an unset variable is a level-0 warning, which is
! fatal at the default BOMLEV, so lower BOMLEV across the call and self-skip
! when the data has not been provisioned here.  The file check matters as
! well: SCCDFTB_DATA can be set while this particular file is absent, and
! CHARMM then dies part way through reading parameters with no termination
! line at all.
set sccdftbdir UNSET_SCCDFTB_DATA
set oldbomlev ?bomlev
bomlev -5
genv sccdftbdir SCCDFTB_DATA
bomlev @oldbomlev
if @sccdftbdir eq UNSET_SCCDFTB_DATA then
   echo SCCGSBP2_2CBA TESTCASE RESULT: SKIP
   stop
endif
strc sccdat @sccdftbdir "/sccdftb_ONCH.dat"
bomlev -5
open unit 98 read form name @sccdat
if ?iostat .ne. 1 then
   echo SCCGSBP2_2CBA TESTCASE RESULT: SKIP
   stop
endif
close unit 98
bomlev @oldbomlev
stream @0sccgsbp_system.str

! The regions this builds are stored in xcomp (reaction), ycomp (buffer) and
! wcomp (outer), one flag per atom, so summing each gives its size.  Those
! three are disjoint and cover everything, which is checkable without
! reference to any captured number: they must add up to the atom count.
! zcomp is the Langevin subset of the buffer region, so it is bounded by it.
scalar xcomp stat
set nreact = ?stot
scalar ycomp stat
set nbuffer = ?stot
scalar zcomp stat
set nlangevin = ?stot
scalar wcomp stat
set nouter = ?stot

calc npartition = @nreact + @nbuffer + @nouter
@testcheck @npartition ?natom 0.000001 sccgsbp2_2cba_partition_covers_system

! The Langevin set is the buffer region minus its hydrogens and waters, so it
! has to be a non-empty proper subset.  Written as a comparison rather than a
! captured size, and oriented so that a NaN fails it.
set nonempty = FAIL
if @nlangevin gt 0 then set nonempty = PASS
echo SCCGSBP2_2CBA_LANGEVIN_NONEMPTY TESTCASE RESULT: @nonempty

set subset = FAIL
if @nlangevin lt @nbuffer then set subset = PASS
echo SCCGSBP2_2CBA_LANGEVIN_WITHIN_BUFFER TESTCASE RESULT: @subset

! and pin the sizes, so a change in how the selections are parsed shows up
! here rather than as a number moving somewhere downstream
@testcheck ?natom 4525 0.000001 sccgsbp2_2cba_natom
@testcheck @nreact 2481 0.000001 sccgsbp2_2cba_reaction_region
@testcheck @nbuffer 1469 0.000001 sccgsbp2_2cba_buffer_region
@testcheck @nouter 575 0.000001 sccgsbp2_2cba_outer_region

STOP

