* CHARMM 31 testcase sccgsbp1_2cba.inp
* .Test SCCGSBP, the QM/MM approach using SCC-DFTB and GSBP for 
*  Carbonic Anhydrase
* .Construct MIJ matrix without water
* .Construct PHIX (external static field)
* .Author:  P. Schaefer, Univ. Wisc. Madison  June 2004
*

IF ?SCCDFTB .NE. 1 THEN
 echo "c32test/sccgsbp1_2cba> SCCDFTB Test NOT performed."
 STOP
endif

IF ?QGSBP .NE. 1 THEN
 echo "c32test/sccgsbp1_2cba> GSBP Test NOT performed."
 STOP
endif

bomb -5

! variables
stream datadir.def

! SCC-DFTB needs SCCDFTB_DATA pointing at a directory holding this test's
! parameter file.  `genv' on an unset variable is a level-0 warning, which is
! fatal at the default BOMLEV, so lower BOMLEV across the call and self-skip
! when the data has not been provisioned here.  The file check matters as
! well: SCCDFTB_DATA can be set while this particular file is absent, and
! CHARMM then dies part way through reading parameters with no termination
! line at all.
set sccdftbdir UNSET_SCCDFTB_DATA
set oldbomlev ?bomlev
bomlev -5
genv sccdftbdir SCCDFTB_DATA
bomlev @oldbomlev
if @sccdftbdir eq UNSET_SCCDFTB_DATA then
   echo SCCGSBP1_2CBA TESTCASE RESULT: SKIP
   stop
endif
strc sccdat @sccdftbdir "/sccdftb_ONCH.dat"
bomlev -5
open unit 98 read form name @sccdat
if ?iostat .ne. 1 then
   echo SCCGSBP1_2CBA TESTCASE RESULT: SKIP
   stop
endif
close unit 98
bomlev @oldbomlev
stream @0sccgsbp_matrices.str

! What this testcase produces is three files, so check they are there and
! readable rather than trusting that the run said nothing.
set nmissing 0
bomlev -5
open unit 50 read file name @9@k_MIJ1.dat
if ?iostat .ne. 1 then
   incr nmissing by 1
endif
close unit 50
open unit 50 read file name @9@k_MIJ2.dat
if ?iostat .ne. 1 then
   incr nmissing by 1
endif
close unit 50
open unit 50 read file name @9@k_phix.dat
if ?iostat .ne. 1 then
   incr nmissing by 1
endif
close unit 50
bomlev @oldbomlev
@testcheck @nmissing 0 -0.5 sccgsbp1_2cba_matrices_written

STOP

