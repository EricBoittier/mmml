* DOMDEC Drude test case, Antti-Pekka Hynninen
* Modified from input script by Alexey Savelyev
* Fixes/corrections by Stefan Boresch
*

if ?domdec .ne. 1 then
   echo "Test NOT performed. DOMDEC must be defined in pref.dat"
   stop
endif

if ?NUMNODE .lt. 2 then
   echo "Test NOT performed. This test may take > 5 min. with 1 process."
   stop
endif

stream datadir.def

stream @0/toppar_drude_master_protein_2013b.str
stream @0/toppar_drude_nucleic_acid_2013b_no_rna.str

open read card unit 10 name @0/ecor1_equil_drude.psf
read psf card unit 10
close unit 10

open read unit 10 card name @0/ecor1_equil_drude.crd
read coor unit 10 card
close unit 10

format (f16.6)

set cutim  13.0  ! cutim
set cutnb  13.0  ! cutnb
set ctonnb 9.0  ! ctonnb
set ctofnb 12.0  ! ctofnb
set eatom atom
set etrun switch
set vatom vatom
set vtrun vswitch
! Fixed energy value
set enerc -48260.091567

crystal define cubic 55  55  55  90.0 90.0 90.0
crystal build noper 0 cutoff @cutim

image byseg xcen 0.0 ycen 0.0 zcen 0.0 select segid DNA* end
image byres xcen 0.0 ycen 0.0 zcen 0.0 select (segid SOD .or. segid CLA  .or. segid SOLV) end

update inbfrq -1 imgfrq -1 ihbfrq 0 -
ewald pmewald kappa 0.34 fftx 64 ffty 64 fftz 64 order 6 lrc -
@eatom @etrun @vatom @vtrun cutnb @cutnb ctonnb @ctonnb ctofnb @ctofnb -
cutim @cutim

energy
coor force comp
!write coor comp card name force.crd
calc eold = ?ener

! Reference energy of this fixed geometry, so it is independent of the
! random-number generator and of the number of ranks.  Keep the original
! absolute 1e-6: `format (f16.6)' above rounds the substituted ?ENER to
! six decimals, so this compares at print precision and is attainable.
! Only the reporting changes -- the comparison itself already worked.
@testcheck ?ener @enerc -0.000001 domdec_drude_energy_nondomdec

energy domdec
coor force
!write coor card name force_dd.crd
coor rms comp

! DOMDEC has to reproduce the non-DOMDEC energy and forces for the same
! coordinates; only the summation order differs.  This is the actual
! point of the test.  The original absolute 1e-4 is kept.
@testcheck ?ener @eold -0.0001 domdec_drude_energy_domdec

if ?rms gt 0.0003 then
   echo domdec_drude_force_domdec TESTCASE RESULT: FAIL
else
   echo domdec_drude_force_domdec TESTCASE RESULT: PASS
endif

!-----------------------------------------------------------
! Test dynamics
! NOTE: This part under development!
!-----------------------------------------------------------

scalar fbeta set  5. select ( .not. type D* ) end
scalar fbeta set 10. select (       type D* ) end

open read unit 10 card name @0/ecor1_equil_drude.crd
read coor unit 10 card
close unit 10

SHAKE bonh param tolerance 1.0e-9 -
      fast water swm4 -
      select  .not. type D*  end -
      select  .not. type D*  end

DrudeHardWall L_WALL 0.2 ! set the hard wall at 0.2 Angstrom

!SB: optional: if uncommented, parallel runs with the old code should
!    reproducible for diff. numbers of cores
!
! Seed explicitly: without a seed the generator takes one from the clock
! and echoes it, so the `RANDSPEC> seeds' line differed on every run.
! One seed is the portable spelling: the previous generator that
! test.com selects with -prevclcg takes exactly one, and CLCG replicates
! it across all four.  Passing four instead leaves three unconsumed
! under -prevclcg and draws an "extraneous characters" warning.
random para iseed 1
!

domdec off
dyna lang start  -
     nstep 100 time 0.0005 -
     nprint 10 iprfrq 100 -
     firstt  240.0 finalt 300.0 iseed 1 2 3 4 -
     rbuf 0.0 tbath 300. -
     iunwri -1

set enodd = ?ener

open read unit 10 card name @0/ecor1_equil_drude.crd
read coor unit 10 card
close unit 10

domdec
dyna lang start  -
     nstep 100 time 0.0005 -
     nprint 10 iprfrq 100 -
     firstt  240.0 finalt 300.0 iseed 1 2 3 4 -
     rbuf 0.0 tbath 300. -
     iunwri -1

set edd = ?ener

! Both Langevin runs have to stay on a physical trajectory.  These are
! stochastic, so their endpoints are not comparable to a captured number
! -- but a diverging or NaN run leaves the energy far from where it
! started, and the test is written so that a NaN fails rather than
! slipping through a `gt' comparison.  The 100 steps of Langevin heating
! relax this system by about 2300 kcal/mol, so the band sits well above
! that while staying orders of magnitude below a genuine blowup.
calc devnodd = abs ( @enodd - @eold )
calc devdd   = abs ( @edd - @eold )

if @devnodd lt 10000 then
   echo domdec_drude_dyna_nondomdec_stable TESTCASE RESULT: PASS
else
   echo domdec_drude_dyna_nondomdec_stable TESTCASE RESULT: FAIL
endif

if @devdd lt 10000 then
   echo domdec_drude_dyna_domdec_stable TESTCASE RESULT: PASS
else
   echo domdec_drude_dyna_domdec_stable TESTCASE RESULT: FAIL
endif

stop
