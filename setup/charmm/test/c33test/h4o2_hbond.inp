* CHARMM c33a1 Testcase h4o2_hbond.inp
* test case for the additional function in SCCDFTB
* hbond: HBOND
* switched gaussian repulsion for o-h repulsion: GAUSW
* Author: Haibo Yu & Qiang Cui, June 2005, UW Madison
* needs to change sccdftb.dat.hbond to sccdftb.dat
*

if ?SCCDFTB .NE. 1 then
  echo H4O2_HBOND TESTCASE RESULT: SKIP
  STOP
endif

stream datadir.def

! SCC-DFTB needs SCCDFTB_DATA pointing at a directory holding this test's
! parameter file.  `genv' on an unset variable is a level-0 warning, which is
! fatal at the default BOMLEV, so lower BOMLEV across the call and self-skip
! when the data has not been provisioned here.  The file check matters as
! well: SCCDFTB_DATA can be set while this particular file is absent, and
! CHARMM then dies part way through reading parameters with no termination
! line at all.
set sccdftbdir UNSET_SCCDFTB_DATA
set oldbomlev ?bomlev
bomlev -5
genv sccdftbdir SCCDFTB_DATA
bomlev @oldbomlev
if @sccdftbdir eq UNSET_SCCDFTB_DATA then
   echo H4O2_HBOND TESTCASE RESULT: SKIP
   stop
endif
! HBOND reads the correction parameter kl1 from the parameter file, and this
! testcase asks for HBOND without D3RD or DHUB -- so dylcao.F skips the
! Hubbard-derivative block entirely and reads kl1 from the record straight
! after the pair list.  The shared sccdftb_ONCH.dat has Hubbard derivatives
! there ('O' -0.1575), which is why this test dies inside a list-directed
! read rather than reporting anything.  It needs a file laid out the way
! data/sccdftb.dat.hbond is: pair lines, then kl1.  The generator does not
! write one yet, so the check below turns that into a skip.
strc sccdat @sccdftbdir "/sccdftb_ONCH_hbond.dat"
bomlev -5
open unit 98 read form name @sccdat
if ?iostat .ne. 1 then
   echo H4O2_HBOND TESTCASE RESULT: SKIP
   stop
endif
close unit 98
bomlev @oldbomlev

OPEN UNIT 21 NAME @0top_all22_prot.inp READ FORM
READ RTF card UNIT 21
CLOSE UNIT 21

OPEN UNIT 22 NAME @0par_all22_prot.inp READ FORM
READ PARA card UNIT 22
CLOSE UNIT 22

read sequ TIP3 2
generate N setup noangle nodihe

READ COOR CARD
*   WATER DIMER
*
    6
    1    1 TIP3 OH2   -1.07861   0.77296  -0.76274 N    1      1.00000
    2    1 TIP3 H1    -1.93957   0.46172  -0.44751 N    1      4.00000
    3    1 TIP3 H2    -0.40091   0.27307  -0.26671 N    1      4.00000
    4    2 TIP3 OH2    1.03836  -0.60758   0.60596 N    2      1.00000
    5    2 TIP3 H1     1.57175   0.09760   1.00009 N    2      4.00000
    6    2 TIP3 H2     1.56629  -1.00366  -0.10224 N    2      4.00000

NBOND atom switch cdie vdw vswitch -
       ctonnb 997 ctofnb 998 cutnb 999

scalar WMAIN set 1.0 sele (all) .and. type O*  SHOW end
scalar WMAIN set 2.0 sele (all) .and. type N*  SHOW end
scalar WMAIN set 3.0 sele (all) .and. type C*  SHOW end
scalar WMAIN set 4.0 sele (all) .and. type H*  SHOW end

! ...... A standard calculation ...... 
SCCDFTB remove CHRG 0 SELE all END TEMP 0.00 SCFT 0.00000001 DATF @sccdat

energy

! ...... Include H-bond and Gaussian switching ......
! ...... Need to include Gaussian switching para in relevant *.spl files ......
SCCDFTB remove CHRG 0 SELE all END TEMP 0.00 SCFT 0.00000001 HBOND GAUSW DATF @sccdat

energy

test first step 0.001

stop

