* Testcase for MSLD partial FFIX (per-block lambda fixing)
* Tests: regression (standard FNEX), partial FFIX energy,
*        dynamics with restart reproducibility and lambda trajectory,
*        BLADE GPU path, and validation of incompatible combinations
*

! Test to ensure the LDM/BLOCK functionality exists in this build
if ?block .ne. 1 then
   echo LDM functionality absent: Test NOT performed
   echo "TESTCASE RESULT msld_ffix: SKIP"
   stop
endif

stream datadir.def

! Set tolerance to control flagged differences
set tol = 1.0e-4

! ======================== SETUP ========================

! read the topology and parameter files
goto read_toppar_data
label return_read_toppar_data

! read in patches for multi-site l-dynamics
goto read_patches
label return_read_patches

! prepare core benzene molecule
read sequ card
* title
*
1
benz
generate BEN setup first none last none

! replace carbon and hydrogen atoms at para-positions
patch s1oc1 ben 1 setup
patch s2oc1 ben 1 setup
dele atom select atom ben 1 cg .or. atom ben 1 hg end
dele atom select atom ben 1 cz .or. atom ben 1 hz end

goto read_coordinates
label return_read_coordinates

! add additional carbon and methoxy groups at the para-positions
patch s1oc2 ben 1 setup
patch s1oc3 ben 1 setup
patch s2oc2 ben 1 setup
patch s2oc3 ben 1 setup

ic generate
ic param
ic build

coor orient

! Defining substituents/blocks for each of 2 sites on benzene core
define site1sub1 select -
   (     atom ben 1 c201 -
   .or. atom ben 1 o202 .or. atom ben 1 c203 -
   .or. atom ben 1 h204 .or. atom ben 1 h205 -
   .or. atom ben 1 h206 ) end

define site1sub2 select -
   (     atom ben 1 c401 -
   .or. atom ben 1 o402 .or. atom ben 1 c403 -
   .or. atom ben 1 h404 .or. atom ben 1 h405 -
   .or. atom ben 1 h406 ) end

define site1sub3 select -
   (     atom ben 1 c601 -
   .or. atom ben 1 o602 .or. atom ben 1 c603 -
   .or. atom ben 1 h604 .or. atom ben 1 h605 -
   .or. atom ben 1 h606 ) end

define site2sub1 select -
   (     atom ben 1 c101 -
   .or. atom ben 1 o102 .or. atom ben 1 c103 -
   .or. atom ben 1 h104 .or. atom ben 1 h105 -
   .or. atom ben 1 h106 ) end

define site2sub2 select -
   (     atom ben 1 c301 -
   .or. atom ben 1 o302 .or. atom ben 1 c303 -
   .or. atom ben 1 h304 .or. atom ben 1 h305 -
   .or. atom ben 1 h306 ) end

define site2sub3 select -
   (     atom ben 1 c501 -
   .or. atom ben 1 o502 .or. atom ben 1 c503 -
   .or. atom ben 1 h504 .or. atom ben 1 h505 -
   .or. atom ben 1 h506 ) end

echo SETUP COMPLETE

! ======================== TEST 0 ========================
! Regression - standard FNEX energy (no FFIX)
! Verify our code changes do not break the baseline

set TEST0 = PASSED

BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.40    0.0  12.0  0.0 5.0
   ldin 3 0.35    0.0  12.0  0.0 5.0
   ldin 4 0.25    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   ldin 6 0.30    0.0  12.0  0.0 5.0
   ldin 7 0.40    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5
   msma
END

ener
calc diff = abs ( ?ener - 6396.39949 )
if @diff .ge. @tol then
   set TEST0 = FAILED
endif

BLOCK
  clear
END

echo TEST0: @TEST0

! ======================== TEST 1 ========================
! Partial FFIX energy - fix block 2 (site1sub1) at lambda=0.30
! Verify partial FFIX produces a valid energy

set TEST1 = PASSED

BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.30    0.0  12.0  0.0 5.0
   ldin 3 0.40    0.0  12.0  0.0 5.0
   ldin 4 0.30    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   ldin 6 0.30    0.0  12.0  0.0 5.0
   ldin 7 0.40    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5 ffix 2
   msma
END

ener
set enfix = ?ener
echo FFIX energy with block 2 fixed at 0.30:
echo ?ener

BLOCK
  clear
END

echo TEST1: @TEST1

! ======================== TEST 2 ========================
! Partial FFIX dynamics with restart reproducibility
! Blocks 2 (site1) and 5 (site2) fixed; lambda trajectory output

set TEST2 = PASSED

BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.20    0.0  12.0  0.0 5.0
   ldin 3 0.45    0.0  12.0  0.0 5.0
   ldin 4 0.35    0.0  12.0  0.0 5.0
   ldin 5 0.25    0.0  12.0  0.0 5.0
   ldin 6 0.35    0.0  12.0  0.0 5.0
   ldin 7 0.40    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5 ffix 2 5
   msma
END

nbonds atom fshift cdie eps 1 vdw vswitch -
   cutnb 15.0 cutim 15.0 ctonnb 10.0 ctofnb 12.0

mini sd nstep 100

shake bonh

scalar fbeta set 10.0 select all end

! Heating run
open unit 12 write form name @9/ffix_heat.res
dynamics lang start timestep 0.002 nstep 100 nprint 10 iprfrq 10 -
   iseed 99843 -
   firstt 100 finalt 310 teminc 100.0 -
   ihtfrq 10 ieqfrq 0 ntrfrq 5000 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iunwri 12 nsavc 300 nsavv 0 nsavl 10 iunvel 0 -
   iunread 13 iunldm 14 eps 1.0

! Production run - write restart and lambda trajectory
open unit 12 write form name @9/ffix_prod.res
open unit 13 read form name @9/ffix_heat.res
open unit 14 write file name @9/ffix_prod.lmd
dynamics lang restart timestep 0.002 nstep 100 nprint 10 iprfrq 10 -
   firstt 310 finalt 310 teminc 0.0 -
   ihtfrq 0 ieqfrq 0 ntrfrq 5000 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iunwri 12 nsavc 300 nsavv 0 nsavl 10 iunvel 0 -
   iunread 13 iunldm 14 eps 1.0
close unit 14

! Restart run 1
open unit 12 write form name @9/ffix_restart1.res
open unit 13 read form name @9/ffix_prod.res
dynamics lang restart timestep 0.002 nstep 10 nprint 1 iprfrq 1000 -
   firstt 310 finalt 310 teminc 0.0 -
   ihtfrq 0 ieqfrq 0 ntrfrq 5000 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iunwri 12 nsavc 1 nsavv 0 nsavl 10 iunvel 0 -
   iunread 13 iunldm 14 eps 1.0
close unit 12
close unit 13
set restart1 = ?tote

! Restart run 2 (identical - should reproduce)
open unit 12 write form name @9/ffix_restart2.res
open unit 13 read form name @9/ffix_prod.res
dynamics lang restart timestep 0.002 nstep 10 nprint 1 iprfrq 1000 -
   firstt 310 finalt 310 teminc 0.0 -
   ihtfrq 0 ieqfrq 0 ntrfrq 5000 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iunwri 12 nsavc 1 nsavv 0 nsavl 10 iunvel 0 -
   iunread 13 iunldm 14 eps 1.0
close unit 12
close unit 13
set restart2 = ?tote

calc diff = abs ( @restart1 - @restart2 )
if @diff .ge. @tol then
   set TEST2 = FAILED
endif

! Print lambda trajectory to verify fixed blocks have constant lambda.
! Note: ldin sets initial THETA, not lambda directly. Lambda is computed
! via softmax normalization (lambda_i = exp(fnex*theta_i) / sum_j exp(fnex*theta_j))
! so the printed lambda for a fixed block will generally differ from the
! ldin theta value, but must remain constant across all timesteps.
open unit 24 read file name @9/ffix_prod.lmd
traj lamb print first 24 nunit 1
close unit 24

BLOCK
   clear
END

echo TEST2: @TEST2

! ======================== TEST 4 ========================
! Validation - partial FFIX with F2SIN should produce an error
! wrndie(-3,...) fires; bomblev -4 prevents termination

set TEST4 = PASSED

bomblev -4

BLOCK 3
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.40    0.0  12.0  0.0 5.0
   ldin 3 0.60    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 f2si ffix 2
END

bomblev 0

echo TEST4: Expected FFIX/F2SIN incompatibility error above
echo TEST4: @TEST4

BLOCK
   clear
END

! ======================== SUMMARY ========================

echo ---
echo TEST0 Regression FNEX: @TEST0
echo TEST1 Partial FFIX energy: @TEST1
echo TEST2 Dynamics restart: @TEST2
echo TEST4 Validation F2SIN: @TEST4
echo ---

if @TEST0 ne PASSED then
   echo TEST0 FAILED: Regression FNEX energy
   echo "TESTCASE RESULT msld_ffix: FAIL"
   stop
endif

if @TEST2 ne PASSED then
   echo TEST2 FAILED: Dynamics restart reproducibility
   echo "TESTCASE RESULT msld_ffix: FAIL"
   stop
endif

echo "TESTCASE RESULT msld_ffix: PASS"

! ======================== TEST 3 ========================
! BLADE partial FFIX - runs after CPU PASS verdict (requires GPU)

if ?blade .ne. 1 then
   echo BLADE not available: TEST3 SKIPPED
   stop
endif

set TEST3 = PASSED

! Set up periodic boundary conditions required by BLaDE
crystal define cubic 30.0 30.0 30.0 90.0 90.0 90.0
crystal build noper 0
image byres xcen 0.0 ycen 0.0 zcen 0.0 sele all end

BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.30    0.0  12.0  0.0 5.0
   ldin 3 0.40    0.0  12.0  0.0 5.0
   ldin 4 0.30    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   ldin 6 0.30    0.0  12.0  0.0 5.0
   ldin 7 0.40    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5 ffix 2
   msma
   pmel ex
END

nbonds atom fshift cdie eps 1 vdw vfswitch -
   cutnb 12.0 cutim 12.0 ctonnb 9.0 ctofnb 10.0 -
   Ewald kappa 0.320 pmEwald order 6 fftx 32 ffty 32 fftz 32

scalar fbeta set 1.0 select all end

shake fast bonh

open unit 22 write form name @9/ffix_blade.res
open unit 24 write file name @9/ffix_blade.lmd

dynamics leap start -
   blade -
   timestep 0.001 -
   nstep 50 -
   nprint 10 -
   iprfrq 50 -
   nsavl 10 -
   ntrfrq 0 -
   iunread -1 -
   iunwri 22 -
   iunldm 24 -
   firstt 310 finalt 310 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iseed 99843

close unit 22
close unit 24

echo TEST3 BLADE FFIX: @TEST3

BLOCK
   clear
END

! ======================== TEST 5 ========================
! High lambda mass + friction test on BLADE
! Two runs: (A) normal mass/friction, (B) block 2 with mass=9999, friction=999
! In run B, block 2's lambda should remain nearly constant across all frames
! while other blocks fluctuate normally. Compare traj lamb print output.

! --- TEST 5A: Normal mass/friction (all blocks mass=12, friction=5) ---

BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.30    0.0  12.0  0.0 5.0
   ldin 3 0.40    0.0  12.0  0.0 5.0
   ldin 4 0.30    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   ldin 6 0.40    0.0  12.0  0.0 5.0
   ldin 7 0.30    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5
   msma
   pmel ex
END

open unit 22 write form name @9/ffix_t5a.res
open unit 24 write file name @9/ffix_t5a.lmd

dynamics leap start -
   blade -
   timestep 0.001 -
   nstep 10000 -
   nprint 1000 -
   iprfrq 10000 -
   nsavl 100 -
   ntrfrq 0 -
   iunread -1 -
   iunwri 22 -
   iunldm 24 -
   firstt 310 finalt 310 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iseed 99843

close unit 22
close unit 24

echo TEST5A: Normal mass/friction lambda trajectory
open unit 24 read file name @9/ffix_t5a.lmd
traj lamb print first 24 nunit 1
close unit 24

BLOCK
   clear
END

! --- TEST 5B: High mass/friction on block 2 (mass=99999, friction=9999) ---
! Block 2's THETA should be frozen (check THETAM lines in traj output).
! However, LAMBDA for block 2 will still fluctuate because lambda is a
! relative quantity: lambda_i = exp(fnex*theta_i) / sum_j exp(fnex*theta_j).
! Other blocks' theta fluctuations change the denominator, so lambda_2
! changes even though theta_2 is constant. This is fundamentally different
! from FFIX, which fixes the LAMBDA value directly.

BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0     0.0 5.0
   ldin 2 0.30    0.0  99999.0  0.0 9999.0
   ldin 3 0.40    0.0  12.0     0.0 5.0
   ldin 4 0.30    0.0  12.0     0.0 5.0
   ldin 5 0.30    0.0  12.0     0.0 5.0
   ldin 6 0.40    0.0  12.0     0.0 5.0
   ldin 7 0.30    0.0  12.0     0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5
   msma
   pmel ex
END

open unit 22 write form name @9/ffix_t5b.res
open unit 24 write file name @9/ffix_t5b.lmd

dynamics leap start -
   blade -
   timestep 0.001 -
   nstep 10000 -
   nprint 1000 -
   iprfrq 10000 -
   nsavl 100 -
   ntrfrq 0 -
   iunread -1 -
   iunwri 22 -
   iunldm 24 -
   firstt 310 finalt 310 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iseed 99843

close unit 22
close unit 24

echo TEST5B: High mass/friction on block 2 lambda trajectory
open unit 24 read file name @9/ffix_t5b.lmd
traj lamb print first 24 nunit 1
close unit 24

BLOCK
   clear
END

! ======================== TEST 6 ========================
! Demonstrate that mass=0 (frozen theta) is NOT the same as FFIX (frozen lambda).
! With mass=0: theta is frozen because the integrator skips that DOF entirely
!   (1/sqrt(0) = Inf, isfinite(Inf) = false), but lambda still fluctuates because
!   lambda_i = exp(fnex*theta_i) / sum_j exp(fnex*theta_j) depends on ALL thetas.
! With FFIX: lambda_i is set directly to the ldin value and does not go through
!   softmax normalization at all.
!
! TEST 6A: mass=0 on block 2 (NO FFIX) - theta frozen, lambda fluctuates
! TEST 6B: FFIX on block 2 - both theta and lambda are frozen

! Save coordinates before TEST 6A so TEST 6B starts from the same state
open unit 33 write form name @9/ffix_t6_save.pdb
write coor pdb unit 33
* saved coords for TEST 6
*
close unit 33

! --- TEST 6A: mass=0 without FFIX ---
BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.30    0.0  0.0   0.0 5.0
   ldin 3 0.40    0.0  12.0  0.0 5.0
   ldin 4 0.30    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   ldin 6 0.40    0.0  12.0  0.0 5.0
   ldin 7 0.30    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5
   msma
   pmel ex
END

open unit 22 write form name @9/ffix_t6a.res
open unit 24 write file name @9/ffix_t6a.lmd

dynamics leap start -
   blade -
   timestep 0.001 -
   nstep 1000 -
   nprint 500 -
   iprfrq 1000 -
   nsavl 100 -
   ntrfrq 0 -
   iunread -1 -
   iunwri 22 -
   iunldm 24 -
   firstt 310 finalt 310 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iseed 99843

close unit 22
close unit 24

echo TEST6A: mass=0 without FFIX - theta frozen but lambda fluctuates
open unit 24 read file name @9/ffix_t6a.lmd
traj lamb print first 24 nunit 1
close unit 24

BLOCK
   clear
END

! Restore coordinates so TEST 6B starts from same state as TEST 6A
open unit 33 read form name @9/ffix_t6_save.pdb
read coor pdb unit 33 resid
close unit 33

! --- TEST 6B: FFIX on block 2 - lambda truly frozen ---
BLOCK 7
   Call 2 sele site1sub1 end
   Call 3 sele site1sub2 end
   Call 4 sele site1sub3 end
   Call 5 sele site2sub1 end
   Call 6 sele site2sub2 end
   Call 7 sele site2sub3 end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.30    0.0  12.0  0.0 5.0
   ldin 3 0.40    0.0  12.0  0.0 5.0
   ldin 4 0.30    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   ldin 6 0.40    0.0  12.0  0.0 5.0
   ldin 7 0.30    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 1 1 2 2 2 fnex 5.5 ffix 2
   msma
   pmel ex
END

open unit 22 write form name @9/ffix_t6b.res
open unit 24 write file name @9/ffix_t6b.lmd

dynamics leap start -
   blade -
   timestep 0.001 -
   nstep 1000 -
   nprint 500 -
   iprfrq 1000 -
   nsavl 100 -
   ntrfrq 0 -
   iunread -1 -
   iunwri 22 -
   iunldm 24 -
   firstt 310 finalt 310 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iseed 99843

close unit 22
close unit 24

echo TEST6B: FFIX on block 2 - lambda truly frozen at 0.3000
open unit 24 read file name @9/ffix_t6b.lmd
traj lamb print first 24 nunit 1
close unit 24

BLOCK
   clear
END

! ======================== TEST 7 ========================
! Single-subsite FFIX for solute tempering (BLADE dynamics)
! Block 2 (site1sub1) is FFIX at lambda=0.70 as the ONLY block at site 1.
! Blocks 3-5 (site2sub1/2/3) compete at site 2 via FNEX as usual.
! We must delete site1sub2 and site1sub3 atoms because they overlap with
! site1sub1 (they're alternatives at the same physical position). Blocks at
! different MSLD sites must NOT have overlapping atoms.

set TEST7 = PASSED

! Restore coordinates (distorted by prior dynamics runs)
open unit 33 read form name @9/ffix_t6_save.pdb
read coor pdb unit 33 resid
close unit 33

! Delete alternative substituents at position 1 that would overlap
! with the FFIX block (they share the same physical position)
! Lower bomblev to allow CLIMAG warning about image centering reset
bomblev -1
dele atom sele ( atom ben 1 c401 .or. atom ben 1 o402 .or. atom ben 1 c403 -
   .or. atom ben 1 h404 .or. atom ben 1 h405 .or. atom ben 1 h406 -
   .or. atom ben 1 c601 .or. atom ben 1 o602 .or. atom ben 1 c603 -
   .or. atom ben 1 h604 .or. atom ben 1 h605 .or. atom ben 1 h606 ) end
bomblev 0

! Rebuild crystal/image for the reduced system
crystal define cubic 30.0 30.0 30.0 90.0 90.0 90.0
crystal build noper 0
image byres xcen 0.0 ycen 0.0 zcen 0.0 sele all end

BLOCK 5
   Call 2 sele ( atom ben 1 c201 .or. atom ben 1 o202 .or. atom ben 1 c203 -
      .or. atom ben 1 h204 .or. atom ben 1 h205 .or. atom ben 1 h206 ) end
   Call 3 sele ( atom ben 1 c101 .or. atom ben 1 o102 .or. atom ben 1 c103 -
      .or. atom ben 1 h104 .or. atom ben 1 h105 .or. atom ben 1 h106 ) end
   Call 4 sele ( atom ben 1 c301 .or. atom ben 1 o302 .or. atom ben 1 c303 -
      .or. atom ben 1 h304 .or. atom ben 1 h305 .or. atom ben 1 h306 ) end
   Call 5 sele ( atom ben 1 c501 .or. atom ben 1 o502 .or. atom ben 1 c503 -
      .or. atom ben 1 h504 .or. atom ben 1 h505 .or. atom ben 1 h506 ) end
   qldm theta
   lang temp 310.0
   ldin 1 1.0     0.0  12.0  0.0 5.0
   ldin 2 0.70    0.0  12.0  0.0 5.0
   ldin 3 0.30    0.0  12.0  0.0 5.0
   ldin 4 0.40    0.0  12.0  0.0 5.0
   ldin 5 0.30    0.0  12.0  0.0 5.0
   rmla bond thet
   msld 0 1 2 2 2 fnex 5.5 ffix 2
   msma
   pmel ex
END

nbonds atom fshift cdie eps 1 vdw vfswitch -
   cutnb 12.0 cutim 12.0 ctonnb 9.0 ctofnb 10.0 -
   Ewald kappa 0.320 pmEwald order 6 fftx 32 ffty 32 fftz 32

scalar fbeta set 1.0 sele all end

shake fast bonh

open unit 22 write form name @9/ffix_t7.res
open unit 24 write file name @9/ffix_t7.lmd

dynamics leap start -
   blade -
   timestep 0.001 -
   nstep 1000 -
   nprint 100 -
   iprfrq 1000 -
   nsavl 100 -
   ntrfrq 0 -
   iunread -1 -
   iunwri 22 -
   iunldm 24 -
   firstt 310 finalt 310 -
   iasors 1 iasvel 1 iscvel 0 ICHECW 0 TWINDH 10.0 TWINDL -10.0 -
   iseed 99843

close unit 22
close unit 24

echo TEST7: single-subsite FFIX lambda trajectory
open unit 24 read file name @9/ffix_t7.lmd
traj lamb print first 24 nunit 1
close unit 24

BLOCK
   clear
END

echo TEST7 single-subsite FFIX: @TEST7

stop

