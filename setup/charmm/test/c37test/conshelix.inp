   75    8 ALA  CA    -1.25654  -1.84896   4.45309 HLX1 8      0.00000
   76    8 ALA  HA    -2.12776  -1.83228   5.09637 HLX1 8      0.00000
   77    8 ALA  CB    -1.28924  -3.09288   3.53690 HLX1 8      0.00000
   78    8 ALA  HB1   -2.18404  -3.05151   2.87868 HLX1 8      0.00000
   79    8 ALA  HB2   -0.38525  -3.11200   2.89204 HLX1 8      0.00000
   80    8 ALA  HB3   -1.32712  -4.02645   4.13796 HLX1 8      0.00000
   81    8 ALA  C     -0.03367  -1.87738   5.37035 HLX1 8      0.00000
   82    8 ALA  O      0.39639  -2.93209   5.83822 HLX1 8      0.00000
   83    9 ALA  N      0.57388  -0.70181   5.62007 HLX1 9      0.00000
   84    9 ALA  HN     0.18355   0.15144   5.28464 HLX1 9      0.00000
   85    9 ALA  CA     1.85022  -0.58815   6.28904 HLX1 9      0.00000
   86    9 ALA  HA     1.94889  -1.37807   7.02298 HLX1 9      0.00000
   87    9 ALA  CB     2.97346  -0.67226   5.22879 HLX1 9      0.00000
   88    9 ALA  HB1    2.90796  -1.63928   4.68667 HLX1 9      0.00000
   89    9 ALA  HB2    2.85794   0.14700   4.48747 HLX1 9      0.00000
   90    9 ALA  HB3    3.97530  -0.59100   5.69950 HLX1 9      0.00000
   91    9 ALA  C      1.94121   0.72823   7.05749 HLX1 9      0.00000
   92    9 ALA  O      3.02063   1.30939   7.18679 HLX1 9      0.00000
   93   10 ALA  N      0.79907   1.22438   7.56071 HLX1 10     0.00000
   94   10 ALA  HN    -0.06196   0.71748   7.60930 HLX1 10     0.00000
   95   10 ALA  CA     0.67986   2.46569   8.28069 HLX1 10     0.00000
   96   10 ALA  HA     1.59435   2.67495   8.82022 HLX1 10     0.00000
   97   10 ALA  CB     0.32168   3.60507   7.30231 HLX1 10     0.00000
   98   10 ALA  HB1    1.12375   3.72941   6.54679 HLX1 10     0.00000
   99   10 ALA  HB2   -0.62790   3.36341   6.77957 HLX1 10     0.00000
  100   10 ALA  HB3    0.18899   4.55223   7.86587 HLX1 10     0.00000
  101   10 ALA  C     -0.45532   2.30743   9.32968 HLX1 10     0.00000
  102   10 ALA  OT1   -1.16420   1.26221   9.28749 HLX1 10     0.00000
  103   10 ALA  OT2   -0.62257   3.22998  10.17388 HLX1 10     0.00000

generate hlx2 dupl hlx1

! Copy coordinates from hlx1 to hlx2
coor dupl sele segid hlx1 end sele segid hlx2 end

! Use your own nonbond options for your own practical applications
update cutnb 50.0 ctofnb 47.0 ctonnb 45.0

define helx1 sele segid hlx1 .and. type CA end
set nca = ?nsel
define helx2 sele segid hlx2 .and. type CA end

! Each `test first' below selects one helix's CA atoms, so TESTFD reports
! 3*nca derivative components and ?NOK counts how many agreed with the
! finite-difference gradient.  TESTFD calls a component OK when its
! deviation is under TOL relative to max(|analytic|,1); the worst
! component here is 8e-5, so 1e-3 keeps an order of magnitude of
! headroom.  The `tol 0.0' this test used before made ?NOK identically
! zero -- TESTFD compares with `.GE. TOL' -- so the ten force tests
! printed a table and checked nothing.
set fdtol = 0.001
calc nfd = 3 * @nca

! nfd comes from the same selection the force tests use, so an empty or
! mis-built selection would make every ?NOK check pass on zero
! components.  Pin the count: this test builds ten-residue helices and
! selects one CA from each residue.
@testcheck @nca 10 -0.5 conshelix_selection_size

! Translate along y-axis to separate helices.
coor trans xdir 0.0 ydir  1.0 zdir 0.0 dist 15.0 sele segid hlx1 end

! Tilt 30 degrees to opposite direction
coor rota xdir 1.0 phi  30 sele segid hlx1 end
coor rota xdir 1.0 phi -30 sele segid hlx2 end

coor copy comp

!-----------------------------------------------------------------------
! Helix-helix distance restraint

coor helix sele helx1 end sele helx2 end
calc dist = ?mind

CONS HELIx DISTance 10.0 FORCe 300.0 -
     sele helx1 end sele helx2 end -
     UDIS 90    STEP  100

skipe all excl ECHD
ENERGY
set e0 = ?ener

test first tol @fdtol sele helx1 end
@testcheck ?nok @nfd -0.5 conshelix_dist_dfirst_hlx1
test first tol @fdtol sele helx2 end
@testcheck ?nok @nfd -0.5 conshelix_dist_dfirst_hlx2

mini sd nstep 60 nprint 10
set e1 = ?ener

set elabel = conshelix_dist_engaged
set slabel = conshelix_dist_satisfied
set return = back_dist
goto checkener
label back_dist

CONS HELIx RESEt

! Now that the restraint is released, `coor helix' reports again.
coor helix sele helx1 end sele helx2 end
set g1 = ?mind
set target = 10.0
set tlabel = conshelix_dist_target
set return = back_dist_geom
goto checkgeom
label back_dist_geom

! copy original coordinates before next test
coor copy
!-----------------------------------------------------------------------
! Helix-helix crossing angle restraint

coor helix sele helx1 end sele helx2 end
calc cros = ?omeg

CONS HELIx CROSs ANGLe 20.0 FORCe 50.0 -
     sele helx1 end sele helx2 end -
     UANG    90 STEP 100

skipe all excl ECHA
ENERGY
set e0 = ?ener

test first tol @fdtol sele helx1 end
@testcheck ?nok @nfd -0.5 conshelix_cross_dfirst_hlx1
test first tol @fdtol sele helx2 end
@testcheck ?nok @nfd -0.5 conshelix_cross_dfirst_hlx2

mini sd nstep 60 nprint 10
set e1 = ?ener

set elabel = conshelix_cross_engaged
set slabel = conshelix_cross_satisfied
set return = back_cross
goto checkener
label back_cross

CONS HELIx RESEt

coor helix sele helx1 end sele helx2 end
set g1 = ?omeg
set target = 20.0
set tlabel = conshelix_cross_target
set return = back_cross_geom
goto checkgeom
label back_cross_geom

! copy original coordinates before next test
coor copy
!-----------------------------------------------------------------------
! Helix-helix hinge angle restraint

coor helix sele helx1 end sele helx2 end
calc hinge = ?hang

CONS HELIx HINGe ANGLe 80.0 FORCe 50.0 -
     sele helx1 end sele helx2 end -
     UANG 90    STEP 100

skipe all excl ECHA
ENERGY
set e0 = ?ener

test first tol @fdtol sele helx1 end
@testcheck ?nok @nfd -0.5 conshelix_hinge_dfirst_hlx1
test first tol @fdtol sele helx2 end
@testcheck ?nok @nfd -0.5 conshelix_hinge_dfirst_hlx2

mini sd nstep 60 nprint 10
set e1 = ?ener

set elabel = conshelix_hinge_engaged
set slabel = conshelix_hinge_satisfied
set return = back_hinge
goto checkener
label back_hinge

CONS HELIx RESEt

! The hinge restraint reaches zero energy at its 80 degree target, but
! ?HANG then reads 100 -- the supplement.  Accept either, so this still
! catches a geometry that is simply wrong without asserting which of the
! two conventions is the intended one.
coor helix sele helx1 end sele helx2 end
calc offhinge = abs ( ?hang - 80.0 )
calc offsuppl = abs ( ?hang - 100.0 )
set g1 = @offhinge
if @offsuppl lt @offhinge set g1 = @offsuppl
set target = 0.0
set tlabel = conshelix_hinge_target
set return = back_hinge_geom
goto checkgeom
label back_hinge_geom

! copy original coordinates before next test
coor copy
!-----------------------------------------------------------------------
! Helix tilt angle restraint

coor helix sele helx1 end
calc tilt = ?tang
coor helix sele helx2 end
calc tilt = ?tang

CONS HELIx ANGLe 30.0 FORCe 1000.0 sele helx1 end -
           UANG   90   STEP  100

CONS HELIx ANGLe 30.0 FORCe 1000.0 sele helx2 end -
           UANG   90   STEP  100

skipe all excl ECHT
ENERGY
set e0 = ?ener

test first tol @fdtol sele helx1 end
@testcheck ?nok @nfd -0.5 conshelix_tilt_dfirst_hlx1
test first tol @fdtol sele helx2 end
@testcheck ?nok @nfd -0.5 conshelix_tilt_dfirst_hlx2

mini sd nstep 60 nprint 10
set e1 = ?ener

! Both helices carry their own tilt restraint; the reported energy is
! their sum, so one pair of checks covers both.
set elabel = conshelix_tilt_engaged
set slabel = conshelix_tilt_satisfied
set return = back_tilt
goto checkener
label back_tilt

CONS HELIx RESEt

! Each helix carries its own tilt restraint, so check both.  The tilt
! energy starts small here (the helices are built at 29.9/30.1 against a
! 30.0 target), so this geometry check, not the energy, is what makes
! the tilt section worth running.
coor helix sele helx1 end
set g1 = ?tang
set target = 30.0
set tlabel = conshelix_tilt_target_hlx1
set return = back_tilt_ga
goto checkgeom
label back_tilt_ga

coor helix sele helx2 end
set g1 = ?tang
set tlabel = conshelix_tilt_target_hlx2
set return = back_tilt_gb
goto checkgeom
label back_tilt_gb

! copy original coordinates before next test
coor copy
!-----------------------------------------------------------------------
! Helix rotation angle restraint

coor helix sele helx1 end refa 5
calc tilt = ?rota
coor helix sele helx2 end refa 5
calc tilt = ?rota

CONS HELIx ROTH ANGLe 150.0 FORCe 500.0 sele helx1 end refa 5 -
           UANG 90    STEP  100

CONS HELIx ROTH ANGLe -30.0 FORCe 500.0 sele helx2 end refa 5 -
           UANG 90     STEP  100

skipe all excl ECHR
ENERGY
set e0 = ?ener

test first tol @fdtol sele helx1 end
@testcheck ?nok @nfd -0.5 conshelix_roth_dfirst_hlx1
test first tol @fdtol sele helx2 end
@testcheck ?nok @nfd -0.5 conshelix_roth_dfirst_hlx2

mini sd nstep 60 nprint 10
set e1 = ?ener

set elabel = conshelix_roth_engaged
set slabel = conshelix_roth_satisfied
set return = back_roth
goto checkener
label back_roth

CONS HELIx RESEt

coor helix sele helx1 end refa 5
set g1 = ?rota
set target = 150.0
set tlabel = conshelix_roth_target_hlx1
set return = back_roth_ga
goto checkgeom
label back_roth_ga

coor helix sele helx2 end refa 5
set g1 = ?rota
set target = -30.0
set tlabel = conshelix_roth_target_hlx2
set return = back_roth_gb
goto checkgeom
label back_roth_gb

stop

!-----------------------------------------------------------------------
! Shared restraint check.
!
! `skipe all excl ECH?' leaves the helix restraint as the only active
! energy term, so the reported energy IS the restraint penalty.  Two
! things then have to be true, and neither is a captured number: the
! restraint has to be doing something at the displaced geometry (E > 0),
! and minimizing against it has to drive it to its analytic minimum of
! zero.  A restraint whose energy reaches zero is satisfied exactly, so
! this says more about the restrained coordinate than re-measuring the
! geometry would -- and it holds at any rank count and under either
! random-number generator, since nothing here follows a `dyna' command.
!
! The restrained coordinate itself is then re-measured after each
! `CONS HELIx RESEt'.  It has to be done after the reset and not right
! after the minimization: source/manip/helix.F90 computes the reported
! ?MIND/?OMEG/?HANG/?TANG/?ROTA only under IF(.NOT.QCONSH), so while a
! restraint is still active `coor helix' leaves them holding whatever
! the previous call put there.

label checkener
  if @e0 le 0 then
     echo @elabel TESTCASE RESULT: FAIL
  else
     echo @elabel TESTCASE RESULT: PASS
  endif
  @testcheck @e1 0 -0.000001 @slabel
goto @return

label checkgeom
  ! The restraint energy reached zero, so the restrained coordinate has
  ! to be sitting on its target.  Absolute tolerance: these land within
  ! about 3e-7 of it.
  @testcheck @g1 @target -0.001 @tlabel
goto @return

stop
