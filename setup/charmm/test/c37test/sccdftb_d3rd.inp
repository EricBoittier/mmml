* CHARMM c37a2 Testcase sccdftb_d3rd.inp
* water dimer test case for DFTB3 (D3RD HBON)
* Michael Gaus & Qiang Cui, July 2012, UW Madison

bomlev 0

if ?SCCDFTB .NE. 1 then
  echo SCCDFTB_D3RD TESTCASE RESULT: SKIP
  STOP
endif

! SCC-DFTB needs SCCDFTB_DATA pointing at a directory holding this test's
! parameter file.  `genv' on an unset variable is a level-0 warning, which is
! fatal at the default BOMLEV, so lower BOMLEV across the call and self-skip
! when the data has not been provisioned here.  The file check matters as
! well: SCCDFTB_DATA can be set while this particular file is absent, and
! CHARMM then dies part way through reading parameters with no termination
! line at all.
set sccdftbdir UNSET_SCCDFTB_DATA
set oldbomlev ?bomlev
bomlev -5
genv sccdftbdir SCCDFTB_DATA
bomlev @oldbomlev
if @sccdftbdir eq UNSET_SCCDFTB_DATA then
   echo SCCDFTB_D3RD TESTCASE RESULT: SKIP
   stop
endif
strc sccdat @sccdftbdir "/sccdftb_OH.dat"
bomlev -5
open unit 98 read form name @sccdat
if ?iostat .ne. 1 then
   echo SCCDFTB_D3RD TESTCASE RESULT: SKIP
   stop
endif
close unit 98
bomlev @oldbomlev

stream datadir.def

OPEN UNIT 21 NAME data/top_all22_prot_na.inp READ FORM
READ RTF card UNIT 21
CLOSE UNIT 21

OPEN UNIT 22 NAME data/par_all22_prot_na.inp READ FORM
READ PARA card UNIT 22
CLOSE UNIT 22

read psf card
PSF CMAP CHEQ

       2 !NTITLE
* WATER DIMER USING PME FROM PENG ZHANG AND MODIFIED BY MICHAEL GAUS            
*  DATE:     7/ 7/12     16: 7:37      CREATED BY USER: mgaus                   

       6 !NATOM
       1 SOLV 1    TIP3 OH2    75  -0.834000       15.9994           0   0.00000     -0.301140E-02
       2 SOLV 1    TIP3 H1      4   0.417000       1.00800           0   0.00000     -0.301140E-02
       3 SOLV 1    TIP3 H2      4   0.417000       1.00800           0   0.00000     -0.301140E-02
       4 SOLV 2    TIP3 OH2    75  -0.834000       15.9994           0   0.00000     -0.301140E-02
       5 SOLV 2    TIP3 H1      4   0.417000       1.00800           0   0.00000     -0.301140E-02
       6 SOLV 2    TIP3 H2      4   0.417000       1.00800           0   0.00000     -0.301140E-02

       6 !NBOND: bonds
       1       2       1       3       2       3       4       5
       4       6       5       6

       2 !NTHETA: angles
       2       1       3       5       4       6

       0 !NPHI: dihedrals


       0 !NIMPHI: impropers


       0 !NDON: donors


       2 !NACC: acceptors
       1       0       4       0

       0 !NNB

       0       0       0       0       0       0

       2       0 !NGRP NST2
       0       1       0       3       1       0

       1 !MOLNT
       1       1       1       1       1       1

       0       0 !NUMLP NUMLPH

       0 !NCRTERM: cross-terms


read coor card
*  WATER DIMER 
*  DATE:     7/ 7/12     16: 7:37      CREATED BY USER: mgaus
*
    6
    1    1 TIP3 OH2    0.00383   1.51352   0.00000 SOLV 1      0.00000
    2    1 TIP3 H1     0.07008   0.54699   0.00000 SOLV 1      0.00000
    3    1 TIP3 H2     0.91405   1.81984   0.00000 SOLV 1      0.00000
    4    2 TIP3 OH2    0.00383  -1.39648   0.00000 SOLV 2      0.00000
    5    2 TIP3 H1    -0.52273  -1.65157   0.76401 SOLV 2      0.00000
    6    2 TIP3 H2    -0.52273  -1.65157  -0.76401 SOLV 2      0.00000


NBONDS  ATOM FSHIFT CDIE VDW VSHIFT  -
        CUTNB 14.0 CTOFNB 12.0 CTONNB 10.0 WMIN 1.5 EPS 1.0 -
        inbfrq -1

define qm sele all end
! define qm sele resid 1 end ! for QM/MM

! for a successful execution a file named sccdftb.dat
! needs to be located at the current working directory,
! the corresponding example sccdftb.dat file can be found
! at data/sccdftb_d3rd_pme.sccdftbdat, the SCCDFTB parameter files
! can be downloaded from the www.dftb.org webpage (mio-1-1)

scalar WMAIN set 1.0 sele (qm) .and. type O*  end
scalar WMAIN set 2.0 sele (qm) .and. type H*  end

SCCDFTB remove SELE qm END TEMP 0.0 SCFT 1e-10 CHRG 0.0 D3RD HBON DATF @sccdat

! Check the starting point before minimizing it away.  The electronic energy
! anchors the parameter set; the other two hold for any parameter set at all.
energy
@testcheck ?qmel -5113.75796 0.000001 sccdftb_d3rd_qmel

! nothing is fixed, so the forces must sum to zero
scalar dx stat
set fx = ?stot
scalar dy stat
set fy = ?stot
scalar dz stat
set fz = ?stot
calc fnet = abs(@fx) + abs(@fy) + abs(@fz)
@testcheck @fnet 0 -0.000001 sccdftb_d3rd_netforce

! isolated dimer, no periodic images: rigid translation changes nothing
set e0 = ?ener
coor trans xdir 1.0 ydir 0.0 zdir 0.0 dist 3.7
energy
calc edrift = abs ( ?ener - @e0 )
@testcheck @edrift 0 -0.0001 sccdftb_d3rd_translation
coor trans xdir -1.0 ydir 0.0 zdir 0.0 dist 3.7
energy

mini abnr nstep 100 tolgrd 0.01 nprint 10

! ABNR was asked for a gradient of 0.01; a water dimer reaches it well inside
! 100 steps, so not reaching it means the D3RD gradient is wrong
@testcheck ?grms 0 -0.01 sccdftb_d3rd_minimized
!mini abnr nstep 3000 tolenr 0.001 tolgrd 0.001

!open write card unit 3 name sccdftb_d3rd-opt.cor
!write coor unit 3 card
!close unit 3

stop

