* hamiltonian REX
*

if ?repdstr .ne. 1 then
 echo "Test NOT performed."
 stop
endif

if ?numnode .ne. 4 then
 echo "Wrong number of processors. Test NOT performed."
 stop
endif

stream datadir.def

read rtf card name @0top_all36_prot.rtf
read para card name @0par_all36_prot.prm
read psf card name @0prot-pos.psf
read coor card name @0prot-mini.crd

energy

repd nrep 4 exch unit 33 freq 20 tham -
   temp 300. -
   temp 330. -
   temp 365. -
   temp 410. -

open unit 20 write form name @9combo-th.out
outu 20

calc l = ?myrep / 10.0

calc c1 = ( @l *  0.21 ) + ( ( 1 - @l ) *  0.130 )
calc c2 = ( @l *  0.05 ) + ( ( 1 - @l ) *  0.075 )
calc c3 = ( @l *  0.05 ) + ( ( 1 - @l ) *  0.075 )
calc c4 = ( @l * -0.30 ) + ( ( 1 - @l ) * -0.960 )
calc c5 = ( @l *  0.33 ) + ( ( 1 - @l ) *  0.340 )
calc c6 = ( @l *  0.33 ) + ( ( 1 - @l ) *  0.340 )
calc c7 = ( @l *  0.33 ) + ( ( 1 - @l ) *  0.000 )

scalar charge set @c1 sele atom a-pro 2 ce  end
scalar charge set @c2 sele atom a-pro 2 he1 end
scalar charge set @c3 sele atom a-pro 2 he2 end
scalar charge set @c4 sele atom a-pro 2 nz  end
scalar charge set @c5 sele atom a-pro 2 hz1 end
scalar charge set @c6 sele atom a-pro 2 hz2 end
scalar charge set @c7 sele atom a-pro 2 hz3 end

open unit 33 write form name @9combo-th.exch

scalar fbeta set 1.0
dyna leap lang start -
  nstep 100 timestep 0.001 nprint 10 iprfrq 100 -
  firstt 300. finalt 300. tstruct 300. tbath 300. -
  iseed 575722 9123209 8004 990261 -
  iasors 1 iasvel 1 iscvel 0 ichecw 0

! Re-evaluate the energy of the current coordinates from scratch; repdstr must
! leave each replica's coordinates and reported energy mutually consistent, so
! the fresh recompute reproduces the dynamics energy to round-off.  Checked live
! below so the test does not go stale on a hard-coded energy that drifts as the
! force field and code evolve (the previous references dated from 2014-2015).
set edyn ?ener
energy
set efresh ?ener

! Test whether the case succeeded or failed. It is easiest
! to do this when we know exactly how many processors there
! were.

set passprob = 0
set passexup = 0
set passexdn = 0
set passener = 0

! Live energy self-consistency: the fresh recompute must match the dynamics
! energy (the strong correctness check; no hard-coded value).
if @edyn .ae. @efresh set passener = 1

! The exchange statistics here are trajectory-dependent -- they shift with the
! force field and RNG, so the exact 2014-era values went stale (e.g. exrup
! drifted 0.5 -> 0).  Rather than hard-code drifting numbers, require them to be
! valid: the acceptance probability and the up/down acceptance ratios must all
! be valid fractions in [0,1].
set passprob = 1
if ?reprob .lt. 0 set passprob = 0
if ?reprob .gt. 1 set passprob = 0
set passexup = 1
if ?exrup .lt. 0 set passexup = 0
if ?exrup .gt. 1 set passexup = 0
set passexdn = 1
if ?exrdn .lt. 0 set passexdn = 0
if ?exrdn .gt. 1 set passexdn = 0

calc result = @passprob + @passexup + @passexdn + @passener

repd reset

outu 6
prnlev 5 node 0

@testcheck @result 4 0 REXTEMPHAM

stop
