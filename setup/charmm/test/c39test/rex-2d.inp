* 2D-REX example on ALA3
* Dimension 1 (freq 200) is temperature.
* Dimension 2 (freq 1000) is Hamiltonian w/ reduced backbone torsion
*

if ?repdstr .ne. 1 then
 echo "REPDSTR code not compiled. Test NOT performed."
 stop
endif

if ?numnode .ne. 4 then
 echo "Wrong number of processors. Test NOT performed."
 stop
endif

stream datadir.def

read rtf card name @0top_all27_prot_lipid_chiral.dat
read para card name @0par_all27_prot_lipid_chiral.dat
read psf card name @0ala3.psf
read coor card name @0ala3.min.cor

energy

repd twod dim1 2 dim2 2 d1criteria temp d2criteria ham -
     d1freq 10 d2freq 20 unit 40 -
     temp 300. temp 340.

open unit 40 write form name @92d-rex.exch
open unit 50 write form name @92d-rex.out
outu 50

echo ?myrepd1
echo ?myrepd2

if ?myrepd1 .eq. 0 set mytemp = 300.
if ?myrepd1 .eq. 1 set mytemp = 340.

define backbone sele type N .or. type CA .or. type C .or. type O end

if ?myrepd2 .eq. 0 set dhstrength = 1.0
if ?myrepd2 .eq. 1 set dhstrength = 0.7

block 2
call 1 sele backbone end                               
call 2 sele .not. backbone end
coef 1 1 1.0 dihe @dhstrength
coef 2 2 1.0
coef 1 2 1.0
end

shake bonh param

scalar fbeta set 10.0

dyna leap lang start nstep 100 timestep 0.001 nprint 10 -
  nsavc 1000 iuncrd 32 iunwri 31 iprfrq 1000 -
  firstt @mytemp finalt @mytemp tstruct @mytemp tbath @mytemp -
  iseed 57590210 9902 8463252 38252523 -
  iasors 1 iasvel 1 iscvel 0 ichecw 0 


! Re-evaluate the energy of the current coordinates from scratch; repdstr must
! leave each replica's coordinates and reported energy mutually consistent, so
! the fresh recompute reproduces the dynamics energy to round-off.  Checked live
! below so the test does not go stale on a hard-coded energy that drifts as the
! force field and code evolve (the previous references dated from 2014-2015).
set edyn ?ener
energy
set efresh ?ener

set passprob  = 0
set passprob2 = 0
set passexup  = 0
set passexup2 = 0
set passexdn  = 0
set passexdn2 = 0
set passener  = 0

! Live energy self-consistency: the fresh recompute must match the dynamics
! energy (the strong correctness check; no hard-coded value).
if @edyn .ae. @efresh set passener = 1

! The exchange statistics are trajectory-dependent (they shift with the force
! field and RNG), so the 2014-era values went stale.  Rather than hard-code
! drifting numbers, require them to be valid: the acceptance probabilities and
! the up/down acceptance ratios in both dimensions must all be fractions in [0,1].
set passprob  = 1
set passprob2 = 1
if ?reprob  .lt. 0 set passprob  = 0
if ?reprob  .gt. 1 set passprob  = 0
if ?reprob2 .lt. 0 set passprob2 = 0
if ?reprob2 .gt. 1 set passprob2 = 0
set passexup  = 1
set passexup2 = 1
if ?exrup  .lt. 0 set passexup  = 0
if ?exrup  .gt. 1 set passexup  = 0
if ?exrup2 .lt. 0 set passexup2 = 0
if ?exrup2 .gt. 1 set passexup2 = 0
set passexdn  = 1
set passexdn2 = 1
if ?exrdn  .lt. 0 set passexdn  = 0
if ?exrdn  .gt. 1 set passexdn  = 0
if ?exrdn2 .lt. 0 set passexdn2 = 0
if ?exrdn2 .gt. 1 set passexdn2 = 0

calc result = @passprob + @passexup + @passexdn + @passener
calc result = @result + @passprob2 + @passexup2 + @passexdn2

repd reset

outu 6
prnlev 5 node 0

@testcheck @result 7 0 REX2D

stop
