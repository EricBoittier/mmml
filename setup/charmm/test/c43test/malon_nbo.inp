* A simple test for the NBO file generation
*

if ?sccdftb .ne. 1 then stop
STREam datadir.def
! SCC-DFTB needs SCCDFTB_DATA pointing at a directory holding this test's
! parameter file.  `genv' on an unset variable is a level-0 warning, which is
! fatal at the default BOMLEV, so lower BOMLEV across the call and self-skip
! when the data has not been provisioned here.  The file check matters as
! well: SCCDFTB_DATA can be set while this particular file is absent, and
! CHARMM then dies part way through reading parameters with no termination
! line at all.
set sccdftbdir UNSET_SCCDFTB_DATA
set oldbomlev ?bomlev
bomlev -5
genv sccdftbdir SCCDFTB_DATA
bomlev @oldbomlev
if @sccdftbdir eq UNSET_SCCDFTB_DATA then
   echo MALON_NBO TESTCASE RESULT: SKIP
   stop
endif
strc sccdat @sccdftbdir "/sccdftb_CHO.dat"
bomlev -5
open unit 98 read form name @sccdat
if ?iostat .ne. 1 then
   echo MALON_NBO TESTCASE RESULT: SKIP
   stop
endif
close unit 98
bomlev @oldbomlev

ioformat extended

read rtf card name @0/top_all36_cgenff.rtf
read para card flex name @0/par_all36_cgenff.prm
read psf card name @0/malon.psf
read coor card name @0/malon.crd
stream @0/malon.str

coor stat
coor orient

!SCC-DFTB
define qm sele segid MALON show end

scalar WMAIN set 1.0 sele (qm) .and. type C*  SHOW end
scalar WMAIN set 2.0 sele (qm) .and. type H*  SHOW end
scalar WMAIN set 3.0 sele (qm) .and. type O*  SHOW end

SCCDFTB remove CHRG 0 SELE QM END TEMP 0.0 SCFT 0.00000001 D3RD HBOND NBO DATF @sccdat

energy !value is -8300.99418 if use hh with the 3OB parameters
       !will generate nbo.47 file, which can be read by the NBO program

@testcheck ?ener -8300.99418 0.005 malon_nbo

STOP

