* CHARMM c35a1 testcase: 15-Aug-2007
* buta_ghosccdftb.inp - test GHO-SCCDFTB for a new feature
* of rearranging the GHO atoms internallly: butane 
*  MINIMIZATION OF LIGAN PLUS ENZIME 
*
  
stream datadir.def
! SCC-DFTB needs SCCDFTB_DATA pointing at a directory holding this test's
! parameter file.  `genv' on an unset variable is a level-0 warning, which is
! fatal at the default BOMLEV, so lower BOMLEV across the call and self-skip
! when the data has not been provisioned here.  The file check matters as
! well: SCCDFTB_DATA can be set while this particular file is absent, and
! CHARMM then dies part way through reading parameters with no termination
! line at all.
set sccdftbdir UNSET_SCCDFTB_DATA
set oldbomlev ?bomlev
bomlev -5
genv sccdftbdir SCCDFTB_DATA
bomlev @oldbomlev
if @sccdftbdir eq UNSET_SCCDFTB_DATA then
   echo BUTA_GHOSCCDFTB TESTCASE RESULT: SKIP
   stop
endif
strc sccdat @sccdftbdir "/sccdftb_CH.dat"
bomlev -5
open unit 98 read form name @sccdat
if ?iostat .ne. 1 then
   echo BUTA_GHOSCCDFTB TESTCASE RESULT: SKIP
   stop
endif
close unit 98
bomlev @oldbomlev

if ?sccdftb .ne. 1 then
   echo BUTA_GHOSCCDFTB TESTCASE RESULT: SKIP
   stop
endif
  
!
! Topology file
! -------------
OPEN READ FORMatted UNIT 1 NAME @0top_all22_model.inp
READ RTF CARD UNIT 1
CLOSe UNIT 1
  
!
! Parameter file
! --------------
OPEN READ FORMatted UNIT 1 NAME @0par_all22_prot.inp
READ PARAmeter CARD UNIT 1
CLOSe UNIT 1

!
! sequence 
! ----------------
READ SEQUence CARD 
* test butane
*
 1
BUTA

GENERATE BUTA SETUP

IC PARAM
IC SEED 1 H11 1 C1 1 C2
IC BUILD
IC FILL
IC PURGE
PRINT IC

! -------------------------------------------
! let's define the quantum part of the system
! -------------------------------------------
define qms sele BYNU 4:10 .or. bynu 14  end

define mms sele .not. qms end

nbonds atom cutnb 12.0 ctofnb 11.0 ctonnb 10. 

scalar WMAIN set 1.0 sele qms .and. type C*  SHOW end
scalar WMAIN set 2.0 sele qms .and. type H*  SHOW end

sccdftb remove chrg 0 sele qms end glnk sele bynu 4 .or. bynu 14 end scft 0.00000001 DATF @sccdat

energy

test FIRST step 0.001

mini abnr nstep 200 tolgrd 0.001 nprint 10

print coord 

stop
