    'cuda':     (True,  'NVIDIA CUDA GPU support'),
    'domdec':   (True,  'domain decomposition'),
    'exafmm':   (True,  'ExaFMM support'),
    'fftw':     (True,  'FFTW library'),
    'html':     (True,  'HTML documentation'),
    'mkl':      (True,  "Intel's MKL library"),
    'mpi':      (True,  'MPI parallel support'),
    'opencl':   (True,  'OpenCL features'),
    'openmm':   (True,  'OpenMM GPU support'),
    'openmp':   (True,  'OpenMP threading'),
    'python':   (True,  'pyCHARMM and pip packages'),
    'qchem':    (True,  'Q-CHEM features'),
    'quantum':  (True,  'QUANTUM features'),
    # off-by-default (user can --with-X)
    'abpo':     (False, 'ABPO (requires MPI, activates ENSEMBLE)'),
    'blade':    (False, 'BLaDE GPU engine'),
