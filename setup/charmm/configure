#!/usr/bin/env python3
"""Configure CHARMM for building with CMake.

Drop-in replacement for the legacy bash configure script.  All
command-line flags are preserved for backwards compatibility.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

# ── Feature table ────────────────────────────────────────────────
# (default_on, help_text)
