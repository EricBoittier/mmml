}

# Compiler preset suites: name -> (label, cc, cxx, fc)
COMPILER_SUITES = {
    'gnu':   ('GNU',   'gcc',   'g++',      'gfortran'),
    'gcc':   ('GNU',   'gcc',   'g++',      'gfortran'),
    'intel': ('Intel', 'icx',   'icx',      'ifx'),
    'pgi':   ('PGI',   'pgcc',  'pgc++',    'pgfortran'),
}

# Short-flag aliases: short -> feature name
SHORT_ALIASES = {
    '-u': 'domdec_gpu',
    '-s': 'sccdftb',
    '-q': 'gamess',
}

# Legacy long aliases (without --with- prefix): flag -> feature name
LEGACY_ALIASES = {
    '--repdstr':    'repdstr',
    '--stringm':    'stringm',
    '--sccdftb':    'sccdftb',
    '--gamess':     'gamess',
    '--domdec_gpu': 'domdec_gpu',
    '--nwchem':     'nwchem',
}

# ── Build presets ────────────────────────────────────────────────
# Each preset expands to a list of configure flags that are prepended
# to the command line, so the user can still override individual
# settings (e.g. --preset=gpu --without-openmm).
PRESETS = {
    'gpu': {
        'description': 'Full GPU build (DOMDEC_GPU + BLaDE + FFTDock)',
        'flags': ['-u', '--with-blade', '--with-fftdock'],
    },
    'lite': {
        'description': 'Minimal build for quick compile checks',
        'flags': ['--lite', '--without-python'],
    },
    'qmmm': {
