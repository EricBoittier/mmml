    'ensemble': {
        'description': 'Replica exchange and ensemble methods',
        'flags': ['--with-repdstr', '--with-stringm', '--with-ljpme',
                  '-a', 'ENSEMBLE,ABPO'],
    },
    'serial': {
        'description': 'Serial build (no MPI)',
        'flags': ['--without-mpi'],
    },
}


# ── Source file scanning ─────────────────────────────────────────

def scan_new_source_files(src_dir, build_dir):
    """Find source files not yet listed in the cmake file lists."""
    for lang, suffix in [('fortran', '.F90'), ('c', '.c'), ('cxx', '.cpp')]:
        cmake_file = src_dir / 'tool' / 'cmake' / f'{lang}_files.cmake'
        if not cmake_file.exists():
            continue

        existing = cmake_file.read_text()
        existing_lines = set(existing.splitlines())

        # Find all source files matching the pattern
        found = sorted(
            str(p.relative_to(src_dir))
            for p in src_dir.joinpath('source').rglob(f'*{suffix}')
            if p.is_file()
            and len(p.relative_to(src_dir / 'source').parts) == 2
            and not ({'fftdock', 'eabf', 'domdec_gpu', 'sccdftbint'} & set(p.parts))
        )

        # Filter to files not already in the cmake list
        new_files = [f for f in found if f not in existing_lines]
        if not new_files:
            continue

        # Insert new files before the closing ')'
        lines = existing.rstrip().rstrip(')')
        lines = lines.rstrip() + '\n'
        for f in new_files:
            lines += f + '\n'
        lines += ')\n'
        cmake_file.write_text(lines)


# ── CMake detection ──────────────────────────────────────────────

MIN_CMAKE_VERSION = (3, 18)


def find_cmake(user_cmake):
    """Locate cmake, or exit with a helpful error message."""
    if user_cmake:
        p = Path(user_cmake)
        if not (p.exists() and os.access(p, os.X_OK)):
            print(f'ERROR: specified cmake not found or not executable: '
                  f'{user_cmake}', file=sys.stderr)
            sys.exit(1)
        return user_cmake

    cmake = shutil.which('cmake')
    if not cmake:
        print('ERROR: cmake not found on PATH.\n', file=sys.stderr)
        print('  CHARMM requires CMake >= '
              f'{MIN_CMAKE_VERSION[0]}.{MIN_CMAKE_VERSION[1]}.\n',
              file=sys.stderr)
        print('  Common fixes:', file=sys.stderr)
        print('    - Activate your conda environment '
              '(conda activate <env>)', file=sys.stderr)
        print('    - Check your PATH '
              '(which cmake)', file=sys.stderr)
        print('    - Install via conda: '
              'conda install cmake', file=sys.stderr)
        print('    - Install via package manager: '
              'apt install cmake / yum install cmake / brew install cmake',
              file=sys.stderr)
        print('    - Download binaries: '
              'https://cmake.org/download/\n', file=sys.stderr)
        sys.exit(1)

    # Check version
    try:
        out = subprocess.check_output(
            [cmake, '--version'], text=True,
        ).splitlines()[0]
        ver = out.split()[-1]
        parts = [int(x) for x in ver.split('.')[:2]]
        if tuple(parts) < MIN_CMAKE_VERSION:
            need = f'{MIN_CMAKE_VERSION[0]}.{MIN_CMAKE_VERSION[1]}'
            print(f'ERROR: cmake {ver} is too old (need >= {need}).\n',
                  file=sys.stderr)
            print('  Common fixes:', file=sys.stderr)
            print('    - Activate a conda environment with a newer cmake',
                  file=sys.stderr)
            print(f'    - Update via conda: conda install "cmake>={need}"',
                  file=sys.stderr)
            print('    - Download binaries: https://cmake.org/download/\n',
                  file=sys.stderr)
            sys.exit(1)
    except (subprocess.CalledProcessError, ValueError):
        pass

    return cmake


# ── Compiler detection ───────────────────────────────────────────

def find_compiler_suite(name):
    """Locate a compiler suite and return env vars to set."""
    if name not in COMPILER_SUITES:
        print(f'ERROR: unknown compiler suite: {name}', file=sys.stderr)
        sys.exit(1)

    label, cc, cxx, fc = COMPILER_SUITES[name]
    cc_path = shutil.which(cc)
    cxx_path = shutil.which(cxx)
    fc_path = shutil.which(fc)

    if not (cc_path and cxx_path and fc_path):
        print(f'ERROR: {label} compiler suite not found on PATH',
              file=sys.stderr)
        sys.exit(1)

    return {'CC': cc_path, 'CXX': cxx_path, 'FC': fc_path,
            '_label': f'{label} ({cc_path}, {cxx_path}, {fc_path})'}


# ── Argument parsing ─────────────────────────────────────────────
# We use a custom parser because argparse cannot cleanly handle the
# --with-X / --without-X pattern with a single generic catch-all
# while also supporting legacy short flags like -u, -s, -q and
# bare flags like --repdstr.

def parse_args(argv):
    """Parse configure arguments, returning a settings dict.

    If --preset is found, its flags are expanded first, then the
    remaining user flags are appended so they can override the preset.
    """
    # Extract --preset before main parsing so preset flags come first
    preset_name = None
    remaining = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == '--preset' and i + 1 < len(argv):
            preset_name = argv[i + 1]
            i += 2
        elif arg.startswith('--preset='):
            preset_name = arg.split('=', 1)[1]
            i += 1
        else:
            remaining.append(arg)
            i += 1

    if preset_name:
        if preset_name not in PRESETS:
            print(f'ERROR: unknown preset: {preset_name}', file=sys.stderr)
            print(f'  Available presets: {", ".join(sorted(PRESETS))}',
                  file=sys.stderr)
            sys.exit(1)
        # Preset flags first, then user flags override
        argv = PRESETS[preset_name]['flags'] + remaining
    else:
        argv = remaining

    settings = {
        'preset': preset_name,
        'verbose': False,
        'debug': False,
        'lite': False,
        'static': False,
        'prefix': None,
        'ninja': False,
        'scan_files': True,
        'user_cmake': None,
        'cuda_host_compiler': None,
        'compiler_suite': None,
        'add_keywords': None,
        'remove_keywords': None,
        'cmake_vars': [],
        'cmake_flags': [],
        'features_on': [],
        'features_off': [],
        'as_library': True,
        'sanitize': None,
    }

    i = 0
    while i < len(argv):
        arg = argv[i]

        if arg in ('-h', '-?', '--help'):
            print_help()
            sys.exit(0)

        elif arg in ('-v', '--verbose'):
            settings['verbose'] = True

        elif arg in ('-g', '--debug'):
            settings['debug'] = True

        elif arg == '--relwithdebinfo':
            settings['debug'] = 'relwithdebinfo'

        elif arg == '--sanitize':
            i, val = _require_arg(argv, i, '--sanitize')
            settings['sanitize'] = _merge_sanitize(settings['sanitize'], val)

        elif arg.startswith('--sanitize='):
            val = arg.split('=', 1)[1]
            if not val:
                _missing_arg('--sanitize')
            settings['sanitize'] = _merge_sanitize(settings['sanitize'], val)

        # --with-asan / --with-ubsan / --with-tsan are friendly shortcuts
        # for --sanitize=address etc.  They compose (e.g.,
        # ``--with-asan --with-ubsan`` is equivalent to
        # ``--sanitize=address,undefined``).  TSan is mutually exclusive
        # with ASan and is enforced on the cmake side; we still accept
        # the flag here so an obvious error message reaches the user.
        elif arg == '--with-asan':
            settings['sanitize'] = _merge_sanitize(settings['sanitize'],
                                                  'address')

        elif arg == '--with-ubsan':
            settings['sanitize'] = _merge_sanitize(settings['sanitize'],
                                                  'undefined')

        elif arg == '--with-tsan':
            settings['sanitize'] = _merge_sanitize(settings['sanitize'],
                                                  'thread')

        elif arg in ('-l', '--lite'):
            settings['lite'] = True

        elif arg == '--static':
            settings['features_on'].append('static')

        elif arg == '--without-library':
            settings['as_library'] = False

        elif arg in ('-p', '--prefix'):
            i, val = _require_arg(argv, i, '--prefix')
            settings['prefix'] = val

        elif arg.startswith('--prefix='):
            val = arg.split('=', 1)[1]
            if not val:
                _missing_arg('--prefix')
            settings['prefix'] = val

        elif arg in ('-c', '--cmake'):
            i, val = _require_arg(argv, i, '--cmake')
            settings['user_cmake'] = val

        elif arg.startswith('--cmake='):
            val = arg.split('=', 1)[1]
            if not val:
                _missing_arg('--cmake')
            settings['user_cmake'] = val

        elif arg in ('-a', '--add'):
            i, val = _require_arg(argv, i, '--add')
            settings['add_keywords'] = val

        elif arg.startswith('--add='):
            val = arg.split('=', 1)[1]
            if not val:
                _missing_arg('--add')
            settings['add_keywords'] = val

        elif arg in ('-r', '--remove'):
            i, val = _require_arg(argv, i, '--remove')
            settings['remove_keywords'] = val

        elif arg.startswith('--remove='):
            val = arg.split('=', 1)[1]
            if not val:
                _missing_arg('--remove')
            settings['remove_keywords'] = val

        elif arg == '-D':
            i, val = _require_arg(argv, i, '-D')
            settings['cmake_vars'].append(val)

        elif arg == '-F':
            i, val = _require_arg(argv, i, '-F')
            settings['cmake_flags'].append(val)

        elif arg == '--with-ninja':
            settings['ninja'] = True

        elif arg == '--without-new-files':
            settings['scan_files'] = False

        elif arg == '--with-cuda-host-compiler':
            i, val = _require_arg(argv, i, '--with-cuda-host-compiler')
            settings['cuda_host_compiler'] = val

        elif arg.startswith('--with-cuda-host-compiler='):
            val = arg.split('=', 1)[1]
            if not val:
                _missing_arg('--with-cuda-host-compiler')
            settings['cuda_host_compiler'] = val

        # Compiler suites
        elif arg in ('--with-gnu', '--with-gcc'):
            settings['compiler_suite'] = 'gnu'
        elif arg == '--with-intel':
            settings['compiler_suite'] = 'intel'
        elif arg == '--with-pgi':
            settings['compiler_suite'] = 'pgi'

        # Short aliases (-u, -s, -q)
        elif arg in SHORT_ALIASES:
            settings['features_on'].append(SHORT_ALIASES[arg])

        # Legacy bare flags (--repdstr, --stringm, etc.)
        elif arg in LEGACY_ALIASES:
            settings['features_on'].append(LEGACY_ALIASES[arg])

        # Generic --with-<feature>
        elif arg.startswith('--with-'):
            feat = arg[len('--with-'):]
            settings['features_on'].append(feat)

        # Generic --without-<feature>
        elif arg.startswith('--without-'):
            feat = arg[len('--without-'):]
            settings['features_off'].append(feat)

        elif arg == '--':
            break

        elif arg.startswith('-'):
            print(f'WARNING: unknown option (ignored): {arg}',
                  file=sys.stderr)

        else:
            break

        i += 1

    return settings


def _require_arg(argv, i, flag):
    """Consume the next argument for a flag that requires a value."""
    if i + 1 >= len(argv):
        _missing_arg(flag)
    return i + 1, argv[i + 1]


def _missing_arg(flag):
    print(f'ERROR: {flag} requires an argument', file=sys.stderr)
    sys.exit(1)


def _merge_sanitize(prev, val):
    """Union the comma-separated sanitizer list `val` into `prev`.

    Used so that ``--with-asan --with-ubsan`` (or any combination of
    --sanitize=... + --with-* shortcuts) accumulates the requested
    sanitizers rather than the last flag winning.  Preserves order of
    first appearance.
    """
    items = []
    if prev:
        items.extend(s.strip() for s in prev.split(',') if s.strip())
    for s in val.split(','):
        s = s.strip()
        if s and s not in items:
            items.append(s)
    return ','.join(items) if items else None


# ── Help text ────────────────────────────────────────────────────

EPILOG = """\
environment variables:
  CC, CXX, FC, CUDACXX     Compiler paths
  CUDAToolkit_ROOT          CUDA installation path
  OPENMM_DIR, OPENMM_HOME  OpenMM path
  FFTW_DIR, FFTW_HOME      FFTW path
  MKLROOT, MKL_HOME        Intel MKL path

cmake variables (pass with -D var=val):
  CUDAToolkit_ROOT          CUDA installation path
  MPI_Fortran_COMPILER      MPI Fortran compiler
  CMAKE_CUDA_COMPILER       nvcc path
  CMAKE_CUDA_ARCHITECTURES  target GPU architectures
  OPENMM_PLUGIN_DIR         OpenMM plugin directory
  arch_flag_all             CPU architecture flag (e.g. -march=haswell)
"""


def print_help():
    print('Usage: configure [options]\n')
    print('General options:\n')
    print('  -p, --prefix PATH     Install directory')
    print('  -v, --verbose         Stream cmake\'s full raw output to the console.')
    print('                          Without it, configure stays quiet and prints')
    print('                          only the clean configuration summary.')
    print('  -g, --debug           Debug build (symbols, no optimization)')
    print('  --relwithdebinfo      Optimized build with debug symbols')
    print('  --with-checks         Enable Fortran runtime checks (bounds, etc.)')
    print('  --with-asan           Enable AddressSanitizer (= --sanitize=address)')
    print('  --with-ubsan          Enable UndefinedBehaviorSanitizer')
    print('  --with-tsan           Enable ThreadSanitizer (excludes asan/msan)')
    print('  --sanitize LIST       Enable sanitizers (comma-list: address,undefined,...)')
    print('                          orthogonal to build type;')
    print('                          adds -fno-omit-frame-pointer + -g automatically')
    print('                          and applies to C, C++, Fortran, exe & shared linker')
    print('  -l, --lite            Minimal build (lite pref.dat)')
    print('  -c, --cmake PATH      Path to cmake executable')
    print('  -a, --add KEYWORDS    Add pref.dat keywords (comma-separated)')
    print('  -r, --remove KEYWORDS Remove pref.dat keywords')
    print('  -D var=val            Set a CMake variable')
    print('  -F flag               Pass a raw flag to CMake')
    print('  --with-ninja          Use Ninja instead of Make')
    print('  --static              Link static libraries')
    print('  --without-library     Do not build shared library')
    print('  --without-new-files   Skip source file scanning')
    print('  --preset NAME         Use a predefined build configuration')
    print('                        (extra flags can override preset settings)')

    print('\nBuild presets:\n')
    for name, info in sorted(PRESETS.items()):
        flags = ' '.join(info['flags'])
        print(f'  {name:<12s} {info["description"]}')
        print(f'  {"":<12s}   -> {flags}')

    print('\nEnable features (off by default):\n')
    for name, (default, desc) in sorted(FEATURES.items()):
        if not default:
            short = ''
            for s, feat in SHORT_ALIASES.items():
                if feat == name:
                    short = f' ({s})'
                    break
            print(f'  --with-{name:<18s} {desc}{short}')

    print('\nDisable features (on by default):\n')
    for name, (default, desc) in sorted(FEATURES.items()):
        if default:
            print(f'  --without-{name:<15s} Disable {desc}')

    print('\nCompiler suites:\n')
    print('  --with-gnu, --with-gcc  GNU compilers (gcc, g++, gfortran)')
    print('  --with-intel            Intel compilers (icx, icx, ifx)')
    print('  --with-pgi              PGI compilers (pgcc, pgc++, pgfortran)')
    print('  --with-cuda-host-compiler PATH')
    print('                          Host compiler for nvcc (-ccbin)')
    print()
    print(EPILOG)


# ── Summary rendering ────────────────────────────────────────────
# After cmake configures, it writes charmm_configure_summary.tsv (see
# tool/cmake/configure_summary.cmake) describing the detected toolchain
# and packages.  We read it back and render a clean, aligned report.

SUMMARY_FILE = 'charmm_configure_summary.tsv'

# Display order and headings for the sections cmake emits.
_SECTION_ORDER = [
    ('compiler', 'Compilers'),
    ('parallel', 'Parallelization'),
    ('library',  'Libraries and packages'),
]

_RULE = '─' * 60  # ──────


class _Style:
    """ANSI styling that quietly disables itself when inappropriate.

    Respects the NO_COLOR convention and only emits codes to a real
    terminal, so piped/redirected output stays plain ASCII.
    """

    def __init__(self):
        enabled = (
            sys.stdout.isatty()
            and os.environ.get('NO_COLOR') is None
            and os.environ.get('TERM') != 'dumb'
        )
        self._b = '\033[1m' if enabled else ''
        self._d = '\033[2m' if enabled else ''
        self._g = '\033[32m' if enabled else ''
        self._y = '\033[33m' if enabled else ''
        self._r = '\033[0m' if enabled else ''

    def bold(self, s):  return f'{self._b}{s}{self._r}'
    def dim(self, s):   return f'{self._d}{s}{self._r}'
    def green(self, s): return f'{self._g}{s}{self._r}'
    def yellow(self, s): return f'{self._y}{s}{self._r}'


def _read_summary(build_dir):
    """Parse the cmake-written summary file into a list of records.

    Returns a list of (section, label, status, info, location) tuples,
    or [] if the file is absent (e.g. cmake failed before writing it).
    """
    path = Path(build_dir) / SUMMARY_FILE
    if not path.exists():
        return []
    records = []
    for line in path.read_text().splitlines():
        if not line.strip():
            continue
        fields = line.split('\t')
        fields += [''] * (5 - len(fields))  # tolerate trailing empties
        records.append(tuple(fields[:5]))
    return records


def _print_kv(style, label, value, label_w):
    print(f'  {style.dim(label.ljust(label_w))}  {value}')


def render_summary(settings, build_meta, build_dir, generator):
    """Render the post-configure summary: choices made + what was found."""
    style = _Style()
    records = _read_summary(build_dir)

    print()
    print(style.bold('  CHARMM configuration'))
    print(f'  {_RULE}')

    # ── Build settings (what we asked for) ──
    meta_rows = [
        ('Build type', build_meta['build_type']),
        ('Generator',  generator),
    ]
    if settings['preset']:
        meta_rows.insert(0, ('Preset', settings['preset']))
    if settings['lite']:
        meta_rows.append(('Profile', 'lite (minimal feature set)'))
    if settings['prefix']:
        meta_rows.append(('Install prefix', settings['prefix']))
    meta_rows.append(('Library', 'static' if settings['static']
                      else ('none' if not settings['as_library'] else 'shared')))
    if settings['sanitize']:
        meta_rows.append(('Sanitizers', settings['sanitize']))
    label_w = max(len(k) for k, _ in meta_rows)
    for k, v in meta_rows:
        _print_kv(style, k, v, label_w)

    # ── Detected toolchain / packages (what cmake found) ──
    for section, heading in _SECTION_ORDER:
        rows = [r for r in records if r[0] == section]
        if not rows:
            continue
        print()
        print(f'  {style.bold(heading)}')
        # Align the label column and the info column within this section.
        lbl_w = max(len(r[1]) for r in rows)
        info_w = max((len(r[3]) for r in rows if r[2] == 'found'), default=0)
        for _sec, label, status, info, location in rows:
            if status == 'found':
                left = f'    {label.ljust(lbl_w)}  {style.green("found")}'
                detail = info.ljust(info_w) if info_w else ''
                detail = f'{detail}  {style.dim(location)}'.rstrip()
                print(f'{left}   {detail}'.rstrip())
            else:
                print(f'    {label.ljust(lbl_w)}  {style.yellow("not found")}')

    # ── Requested optional features ──
    if settings['features_on']:
        print()
        print(f'  {style.bold("Optional features enabled")}')
        print(f'    {", ".join(sorted(settings["features_on"]))}')
    if settings['add_keywords'] or settings['remove_keywords']:
        print()
        if settings['add_keywords']:
            print(f'  {style.dim("Added keywords:  ")}{settings["add_keywords"]}')
        if settings['remove_keywords']:
            print(f'  {style.dim("Removed keywords:")}{settings["remove_keywords"]}')

    print(f'  {_RULE}')


# ── CMake warning surfacing ──────────────────────────────────────

def find_unused_cmake_vars(captured):
    """Return the list of -D variables cmake accepted but did not use.

    On a successful configure we normally swallow cmake's stdout and show
    only our own summary.  But a mistyped -D cache variable (e.g.
    CMAKE_CUDA_ARCHETECTURES for CMAKE_CUDA_ARCHITECTURES) is not an error:
    cmake accepts it, silently ignores it, and only mentions it in a
    "Manually-specified variables were not used by the project" warning on the
    success path -- exactly the output we swallow.  That lets a typo, and thus
    a wrong/default GPU architecture, pass unnoticed.  Parse the variable names
    out of that warning block so the caller can flag them.
    """
    if not captured:
        return []
    lines = captured.splitlines()
    marker = 'Manually-specified variables were not used by the project:'
    unused = []
    for i, line in enumerate(lines):
        if marker in line:
            # cmake prints a blank line, then the variable names one per
            # indented line, then a blank line.  Skip the leading blank(s), then
            # stop at the first blank or non-indented line once the list began,
            # so we don't absorb unrelated output that follows the block.
            started = False
            for var in lines[i + 1:]:
                if var.strip() == '':
                    if started:
                        break
                    continue
                if var[:1] not in (' ', '\t'):
                    break
                started = True
                unused.append(var.strip())
            break
    return unused


def select_macos_sdk(cc, cmake_args, env, extra_link_args=None):
    """On macOS, make sure the build links against an SDK the compiler can use.

    A conda-forge toolchain ships an older ld64 that cannot read the .tbd stub
    libraries of a recent Xcode / Command Line Tools SDK (e.g. SDK 26), so
    linking C/C++ against the default SDK fails with undefined libSystem
    symbols (_printf, ___stack_chk_fail).  Only override when the default SDK
    does not actually link, so the common cases -- Linux, the system Apple
    toolchain, or an older default SDK -- are left completely untouched.  The
    user can still force a specific SDK with -D CMAKE_OSX_SYSROOT=... .

    extra_link_args lets the probe demand more than libSystem: for a Metal
    (FFTDOCK) build we pass the Metal framework link flags so the SDK we pick
    is guaranteed new enough to link the Metal/MPSGraph backend (macOS 14+),
    not merely to link a trivial C program.  (The .metal->.metallib shader
    compile goes through `xcrun -sdk macosx metal` and is independent of
    CMAKE_OSX_SYSROOT, so only the host-side framework link is at issue here.)

    Mutates cmake_args / env in place; exits with remediation if nothing links.
    """
    import glob
    import platform
    import re
    import tempfile

    extra_link_args = extra_link_args or []

    if platform.system() != 'Darwin':
        return
    if any('CMAKE_OSX_SYSROOT' in a for a in cmake_args):
        return

    tmpd = tempfile.mkdtemp(prefix='chm_sdk_probe.')
    try:
        probe = os.path.join(tmpd, 'probe.c')
        with open(probe, 'w') as fh:
            fh.write('#include <stdio.h>\nint main(void){printf("");return 0;}\n')

        def links(sdk):
            cmd = [cc]
            if sdk:
                cmd += ['-isysroot', sdk]
            cmd += [probe, '-o', probe + '.out'] + extra_link_args
            try:
                rc = subprocess.run(cmd, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL).returncode
            except OSError:
                rc = 1
            try:
                os.remove(probe + '.out')
            except OSError:
                pass
            return rc == 0

        if links(''):
            return  # default SDK links; leave everything untouched

        print('=====')
        print(f'macOS: default SDK does not link with {cc} (conda ld64 vs a')
        print('       recent Xcode SDK); searching for a compatible SDK...')

        candidates = []
        for pat in (
                '/Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk',
                '/Applications/Xcode.app/Contents/Developer/Platforms/'
                'MacOSX.platform/Developer/SDKs/MacOSX*.sdk'):
            candidates += glob.glob(pat)

        def _ver(path):
            m = re.search(r'MacOSX([0-9]+(?:\.[0-9]+)?)\.sdk', path)
            return [int(x) for x in m.group(1).split('.')] if m else [0]

        candidates.sort(key=_ver, reverse=True)  # newest SDK first

        for sdk in candidates:
            if os.path.isdir(sdk) and links(sdk):
                print(f'macOS: building against SDK {sdk}')
                cmake_args.append(f'-DCMAKE_OSX_SYSROOT={sdk}')
                env['SDKROOT'] = sdk
                env['CONDA_BUILD_SYSROOT'] = sdk
                return

        print('=====')
        print(f'ERROR: no installed macOS SDK links with the compiler ({cc}).')
        if extra_link_args:
            print('       (this build also requires the Metal frameworks, so the')
            print('        SDK must be recent enough -- macOS 14+ -- for MPSGraph.)')
        print('       The conda-forge linker (ld64) cannot read the .tbd stub')
        print('       libraries of the SDK(s) on this machine, so the build')
        print('       would fail at link time.  To fix, do ONE of the following')
        print('       and re-run configure:')
        print('')
        print('   1. Install an older, compatible Command Line Tools SDK (SDK 15')
        print('      is known to work) under')
        print('      /Library/Developer/CommandLineTools/SDKs/')
        print('   2. Update the conda linker toolchain:')
        print('        conda update -c conda-forge cctools ld64')
        print('   3. Use the system Apple toolchain instead of the conda')
        print('      compilers (unset CC, CXX and FC).')
        print('   4. Point the build at a specific SDK yourself:')
        print('        configure ... -D CMAKE_OSX_SYSROOT=/path/to/MacOSXNN.sdk')
        print('')
        print('   List the SDKs on this machine with:')
        print('        ls /Library/Developer/CommandLineTools/SDKs')
        print('   See doc/cmake.info (CMAKE_OSX_SYSROOT) for details.')
        print('=====')
        sys.exit(2)
    finally:
        shutil.rmtree(tmpd, ignore_errors=True)


# ── Main ─────────────────────────────────────────────────────────

def main():
    original_args = ' '.join(sys.argv[1:])
    settings = parse_args(sys.argv[1:])
    src_dir = Path(__file__).resolve().parent
    build_dir = Path.cwd()

    # ── In-place build detection ──
    in_place_build = False
    if (build_dir / 'install.com').exists() and (build_dir / 'build').is_dir():
        in_place_build = True
        if not settings['prefix']:
            settings['prefix'] = str(build_dir)
        cmake_dir = build_dir / 'build' / 'cmake'
        cmake_dir.mkdir(exist_ok=True)
        os.chdir(cmake_dir)
        build_dir = cmake_dir
        print(f'WARNING: in-place build, using {build_dir}')
    elif any(build_dir.iterdir()):
        print('WARNING: build directory not empty; '
              'a clean directory is recommended')

    if not settings['prefix']:
        print('WARNING: no --prefix; install may write to /usr/local')

    # ── Source file scanning ──
    if settings['scan_files']:
        scan_new_source_files(src_dir, build_dir)

    # ── Compiler suite ──
    # cmake reports the actual compilers it selects in the summary, so we
    # only need the CC/CXX/FC env vars here (drop the display label).
    compiler_env = {}
    if settings['compiler_suite']:
        info = find_compiler_suite(settings['compiler_suite'])
        info.pop('_label', None)
        compiler_env = info

    # ── Find cmake ──
    cmake = find_cmake(settings['user_cmake'])

    # ── Build cmake arguments ──
    cmake_args = []

    if settings['debug'] == 'relwithdebinfo':
        cmake_args.append('-DCMAKE_BUILD_TYPE=RelWithDebInfo')
    elif settings['debug']:
        cmake_args.append('-DCMAKE_BUILD_TYPE=Debug')
    if settings['sanitize']:
        cmake_args.append(f'-Dsanitize={settings["sanitize"]}')
    if settings['lite']:
        cmake_args.append('-Dlite=ON')
    if not settings['as_library']:
        cmake_args.append('-Das_library=OFF')
    if settings['prefix']:
        cmake_args.append(f'-DCMAKE_INSTALL_PREFIX={settings["prefix"]}')
        if in_place_build:
            cmake_args.append('-Din_place_install=ON')
    if settings['ninja']:
        cmake_args.append('-GNinja')
    if settings['add_keywords']:
        cmake_args.append(f'-Dadd_keywords={settings["add_keywords"]}')
    if settings['remove_keywords']:
        cmake_args.append(f'-Dremove_keywords={settings["remove_keywords"]}')
    if settings['cuda_host_compiler']:
        cmake_args.append(
            f'-DCMAKE_CUDA_HOST_COMPILER={settings["cuda_host_compiler"]}')

    for feat in settings['features_on']:
        cmake_args.append(f'-D{feat}=ON')
    for feat in settings['features_off']:
        cmake_args.append(f'-D{feat}=OFF')
    for var in settings['cmake_vars']:
        cmake_args.append(f'-D{var}')
    for flag in settings['cmake_flags']:
        cmake_args.append(flag)

    cmake_args_str = ' '.join(cmake_args)
    cmake_args.append(f'-DCONFIGURE_CMAKE_ARGS={cmake_args_str}')
    cmake_args.append(f'-DCONFIGURE_ARGS={original_args}')

    # ── Build type / generator ──
    gen = 'ninja' if settings['ninja'] else 'make'
    if settings['debug'] == 'relwithdebinfo':
        build_type = 'RelWithDebInfo'
    elif settings['debug']:
        build_type = 'Debug'
    else:
        build_type = 'Release'
    build_meta = {'build_type': build_type}

    # In verbose mode cmake streams its full, raw output to the console.
    # Otherwise we capture it and present only our own clean summary, so
    # an ordinary configure run stays quiet and uniform.
    if not settings['verbose']:
        cmake_args.append('--log-level=WARNING')

    env = os.environ.copy()
    env.update(compiler_env)
    # macOS: ensure the chosen compiler links against a usable SDK (mutates
    # cmake_args / env; no-op off macOS or when CMAKE_OSX_SYSROOT is set).
    # For a Metal FFTDOCK build the picked SDK must also link the Metal
    # frameworks (macOS 14+), so demand them in the probe.
    sdk_extra = []
    if 'metal' in settings['features_on']:
        sdk_extra = ['-framework', 'Metal',
                     '-framework', 'MetalPerformanceShaders',
                     '-framework', 'MetalPerformanceShadersGraph']
    select_macos_sdk(env.get('CC', 'cc'), cmake_args, env, sdk_extra)
    cmd = [cmake] + cmake_args + [str(src_dir)]

    print(f'\nConfiguring CHARMM ({build_type}, {gen}) ...', flush=True)

    if settings['verbose']:
        # Raw passthrough: cmake's stdout/stderr go straight to the console.
        ret = subprocess.run(cmd, env=env)
        captured = None
    else:
        # Capture quietly; we render our own summary on success and only
        # surface cmake's output if it fails.
        ret = subprocess.run(cmd, env=env, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
        captured = ret.stdout

    if ret.returncode != 0:
        if captured:
            print(captured, file=sys.stderr)
        print('\nERROR: cmake configuration failed.', file=sys.stderr)
        print('  See the output above and '
              'CMakeFiles/CMakeError.log for details.', file=sys.stderr)
        sys.exit(2)

    render_summary(settings, build_meta, build_dir, gen)

    # Flag -D variables cmake accepted but ignored (e.g. a mistyped
    # CMAKE_CUDA_ARCHETECTURES).  cmake only reports these in a warning on the
    # success path, which the quiet capture above would otherwise hide.
    if not settings['verbose']:
        unused_vars = find_unused_cmake_vars(captured)
        if unused_vars:
            print()
            print(f'  {_RULE}')
            print('  WARNING: these -D variables were accepted but IGNORED by '
                  'cmake')
            print('  (unrecognized names -- check for a typo):')
            print()
            for var in unused_vars:
                print(f'      {var}')
            print()
            print('  For example CMAKE_CUDA_ARCHITECTURES (not ...ARCHETECTURES)'
                  ' sets the')
            print('  target GPU architecture; a typo leaves it at the default.')
            print(f'  {_RULE}')

    print()
    print('  Configured. To build and install, run:')
    print(f'    {gen} -C {build_dir} install')
    print()

    if in_place_build:
        os.chdir(src_dir)


if __name__ == '__main__':
    main()
