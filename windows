! Weak COM tether: stops global drift in vacuum without confining the
! reaction. Acts on the aggregate COM, so it does NOT bias the internal RCs.
cons hmcm force 2.0 refx 0.0 refy 0.0 refz 0.0 sele all end

! Umbrella grid edge (Å); MMFP walls below use the same upper bound so
! dynamics cannot exceed UM1RXN [min,max] and abort mid-heat.
set adum_rcmax = 8.0
set adum_rcwall = 500.0

open unit 44 write card name ADUMB-WUNI.DAT
open unit 50 write card name UMBCOR
open unit 45 write card name RXNCOR_RCL.DAT
open unit 46 write card name RXNCOR_RCN.DAT

! Points: NH3 N1, CH3Cl C1, CH3Cl CL1 (IUPAC names via ATOM, not TYPE).
! TYPE selects FF labels (NG331/CG331/CLGA1); ATOM * * NAME matches names.
rxncor define pn point select atom * * N1 end
rxncor define pc point select atom * * C1 end
rxncor define pcl point select atom * * CL1 end

! Distances (Angstrom): Cl-C and C-N
rxncor define rcl distance pcl pc
rxncor define rcn distance pc pn
rxncor set nrxn 2 rcl rcn
rxncor trace rcl unit 45
rxncor trace rcn unit 46

! Soft outer walls on traced distances (MMFP RESTR): zero energy for r<=max,
! half-harmonic repulsion outside (force @adum_rcwall). Keeps UM1RXN in range
! without the hard abort when dynamics briefly overshoot the umbrella edge.
MMFP
GEO SPHE DIST HARM OUTS force @adum_rcwall droff @adum_rcmax -
  select atom * * CL1 end -
  select atom * * C1 end
GEO SPHE DIST HARM OUTS force @adum_rcwall droff @adum_rcmax -
  select atom * * C1 end -
  select atom * * N1 end
END

! Adaptive umbrella on Cl-C and C-N distances (Å).
! Use min 0.0: unpatched UM1RXN treats the upper edge as (max-min) when
! min>0 (min 1 max 6 → abort once value > 5 Å). Patched eadumb.F90 uses
! [min, max]; min 0.0 works on both.
! max @adum_rcmax matches MMFP walls; spans reactant–TS–product basins (~6 Å).
umbrella rxncor nresol 20 trig 0 poly 4 min 0.0 max @adum_rcmax name rcl
umbrella rxncor nresol 20 trig 0 poly 4 min 0.0 max @adum_rcmax name rcn

! nsim * update = heat nstep (ps_heat*1000/dt_fs = 200_000 here): 400*500.
! equi 250 of update 500 discards 50% per window (absorbs the boundary redraw);
! lower equi toward ~100 if you want more sampling per window.
umbrella init nsim 400 update 500 equi 250 thresh 10 temp 500 wuni 44 ucun 50
