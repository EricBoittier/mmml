#!/usr/bin/env bash
# Environment script for pcstudix workstation (2x 2x RTX 5090 Blackwell GPUs)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

export MMML_CLUSTER="pcstudix"
export MMML_DEVICE_TYPE="gpu"
export JAX_PLATFORMS="cuda,cpu"
export MMML_MLPOT_DEVICE="cuda"
export JAX_ENABLE_X64=1

# Allow multi-GPU JAX allocation across 2 GPUs per node (2-node dual RTX 5090 cluster)
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

# Ensure CUDA runtime libs are configured
if [[ -f "${REPO_ROOT}/scripts/setup_jax_cuda_env.sh" ]]; then
  source "${REPO_ROOT}/scripts/setup_jax_cuda_env.sh"
fi

source "${REPO_ROOT}/scripts/resolve_mmml_env.sh"
mmml_resolve_env "${REPO_ROOT}"

echo "[pcstudix.env] Environment initialized for pcstudix (4x RTX 5090 GPUs). Python: ${MMML_PYTHON}"
