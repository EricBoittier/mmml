#!/usr/bin/env bash
# Environment script for local_computer (RTX 4060 GPU workstation for CUDA debugging)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

export MMML_CLUSTER="local_computer"
export MMML_DEVICE_TYPE="gpu"
export JAX_PLATFORMS="cuda,cpu"
export MMML_MLPOT_DEVICE="cuda"
export JAX_ENABLE_X64=1

# Use primary single GPU
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

if [[ -f "${REPO_ROOT}/scripts/setup_jax_cuda_env.sh" ]]; then
  source "${REPO_ROOT}/scripts/setup_jax_cuda_env.sh"
fi

source "${REPO_ROOT}/scripts/resolve_mmml_env.sh"
mmml_resolve_env "${REPO_ROOT}"

echo "[local_computer.env] Environment initialized for local computer (RTX 4060 CUDA). Python: ${MMML_PYTHON}"
