#!/usr/bin/env bash
# Environment script for pc-bach (CPU cluster with many cores & high RAM)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

export MMML_CLUSTER="pc-bach"
export MMML_DEVICE_TYPE="cpu"
export JAX_PLATFORMS="cpu"
export MMML_MLPOT_DEVICE="cpu"
export JAX_ENABLE_X64=1

# Load modules if available
if command -v module >/dev/null 2>&1; then
  module load gcc/gcc-12.2.0-cmake-3.25.1-openmpi-4.1.4 2>/dev/null || true
  module load charmm/c47a2-gcc-12.2.0-openmpi-4.1.4 2>/dev/null || true
fi

# Set compiler wrappers and PATHs
export OPENMPI_ROOT="${OPENMPI_ROOT:-/opt/gcc-12.2.0/openmpi-4.1.4/build}"
export PATH="${OPENMPI_ROOT}/bin:${PATH}"
export LD_LIBRARY_PATH="${OPENMPI_ROOT}/lib:${LD_LIBRARY_PATH:-}"

source "${REPO_ROOT}/scripts/resolve_mmml_env.sh"
mmml_resolve_env "${REPO_ROOT}"

echo "[pcbach.env] Environment initialized for pc-bach (CPU / MPI). Python: ${MMML_PYTHON}"
