#!/usr/bin/env bash
# Environment script for local_laptop (Mac / Standard development CPU environment)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

export MMML_CLUSTER="local_laptop"
export MMML_DEVICE_TYPE="cpu"
export JAX_PLATFORMS="cpu"
export MMML_MLPOT_DEVICE="cpu"
export JAX_ENABLE_X64=1

source "${REPO_ROOT}/scripts/resolve_mmml_env.sh"
mmml_resolve_env "${REPO_ROOT}"

echo "[local_laptop.env] Environment initialized for local laptop (CPU). Python: ${MMML_PYTHON}"
