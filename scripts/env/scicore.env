#!/usr/bin/env bash
# Environment script for sciCORE GPU cluster (RTX 4090 - A100 GPUs)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

export MMML_CLUSTER="scicore"
export MMML_DEVICE_TYPE="gpu"
export JAX_PLATFORMS="cuda,cpu"
export MMML_MLPOT_DEVICE="cuda"
export JAX_ENABLE_X64=1

# Load cluster modules if available
if command -v module >/dev/null 2>&1; then
  module load CUDA/12.2.0 2>/dev/null || true
  module load OpenMPI/4.1.4 2>/dev/null || true
fi

# Ensure JAX CUDA library paths are properly prepended
if [[ -f "${REPO_ROOT}/scripts/setup_jax_cuda_env.sh" ]]; then
  source "${REPO_ROOT}/scripts/setup_jax_cuda_env.sh"
fi

source "${REPO_ROOT}/scripts/resolve_mmml_env.sh"
mmml_resolve_env "${REPO_ROOT}"

echo "[scicore.env] Environment initialized for sciCORE (GPU cluster). Python: ${MMML_PYTHON}"
