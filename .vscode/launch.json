{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug mmml",
            "type": "debugpy",
            "module": "mmml.cli",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "md-system",
                "--composition",
                "DCM:4",
                "--ps-heat",
                "0.02",
                "--ps-equi",
                "0.02",
                "--no-echeck",
                "--charmm-sd-steps",
                "1000",
                "--dcd-nsavc",
                "10",
                "--dt-fs",
                "0.125"
            ]
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "md-system",
                "--config",
                "md-configs/test.yaml"
            ]
        },
        {
            "name": "Python: Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            }
        }
    ]
}