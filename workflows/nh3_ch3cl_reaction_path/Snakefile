rule collect:
    input:
        TARGETS,
    output:
        csv="results/summary.csv",
        md="results/summary.md",
    params:
        script=str(WORKFLOW_DIR / "scripts" / "collect_results.py"),
        root=ARTIFACT_ROOT,
    shell:
        r"""
        python {params.script} \
          --artifact-root {params.root} \
          --csv {output.csv} \
          --markdown {output.md}
        """
