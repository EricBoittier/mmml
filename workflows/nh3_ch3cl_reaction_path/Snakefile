rule dmc:
    input:
        _deps(
            f"{ARTIFACT_ROOT}/endpoints/status.json" if enabled(CFG, "endpoints") else None,
        ),
    output:
        status=f"{ARTIFACT_ROOT}/dmc/{{basin}}/seed{{seed}}/status.json",
    log:
        f"{ARTIFACT_ROOT}/dmc/{{basin}}/seed{{seed}}/stdout.log",
    params:
        out=f"{ARTIFACT_ROOT}/dmc/{{basin}}/seed{{seed}}",
        job_shell=JOB_SHELL,
    wildcard_constraints:
        basin="|".join(BASINS) if BASINS else "react|product",
        seed=_SEED_WC,
    resources:
        **_res("dmc"),
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.out}
        bash {params.job_shell} \
          --job dmc \
          --basin {wildcards.basin} \
          --seed {wildcards.seed} \
          --output-dir {params.out} \
          --status {output.status} \
          > {log} 2>&1
        """


rule umbrella_gas:
    input:
        _deps(
            f"{ARTIFACT_ROOT}/endpoints/status.json" if enabled(CFG, "endpoints") else None,
        ),
    output:
        status=f"{ARTIFACT_ROOT}/umbrella_gas/{{variant}}/T{{temperature}}/seed{{seed}}/status.json",
    log:
        f"{ARTIFACT_ROOT}/umbrella_gas/{{variant}}/T{{temperature}}/seed{{seed}}/stdout.log",
    params:
        out=f"{ARTIFACT_ROOT}/umbrella_gas/{{variant}}/T{{temperature}}/seed{{seed}}",
        job_shell=JOB_SHELL,
    wildcard_constraints:
        variant="|".join(VARIANTS),
        temperature=_TEMP_WC,
        seed=_SEED_WC,
    resources:
        gpu=lambda wildcards: int(slurm_value(CFG, "gpu", 1)),
        charmm_slot=1,
        runtime=lambda wildcards: job_runtime_min(CFG, "umbrella_gas", variant=wildcards.variant),
        nodes=lambda wildcards: int(slurm_value(CFG, "nodes", 1)),
        tasks=lambda wildcards: int(slurm_value(CFG, "ntasks", 1)),
        cpus_per_task=lambda wildcards: int(slurm_value(CFG, "cpus_per_task", 4)),
        mem_mb_per_cpu=lambda wildcards: int(slurm_value(CFG, "mem_mb_per_cpu", 4000)),
        slurm_partition=lambda wildcards: str(slurm_value(CFG, "partition", "gpu")),
        slurm_extra=_slurm_extra,
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.out}
        bash {params.job_shell} \
          --job umbrella_gas \
          --variant {wildcards.variant} \
          --temperature {wildcards.temperature} \
          --seed {wildcards.seed} \
          --output-dir {params.out} \
          --status {output.status} \
          > {log} 2>&1
        """


rule umbrella_sol:
    input:
        _deps(
            f"{ARTIFACT_ROOT}/boxes/status.json" if enabled(CFG, "make_boxes") else None,
            f"{ARTIFACT_ROOT}/endpoints/status.json" if enabled(CFG, "endpoints") else None,
        ),
    output:
        status=f"{ARTIFACT_ROOT}/umbrella_sol/{{solvent}}/{{variant}}/T{{temperature}}/seed{{seed}}/status.json",
    log:
        f"{ARTIFACT_ROOT}/umbrella_sol/{{solvent}}/{{variant}}/T{{temperature}}/seed{{seed}}/stdout.log",
    params:
        out=f"{ARTIFACT_ROOT}/umbrella_sol/{{solvent}}/{{variant}}/T{{temperature}}/seed{{seed}}",
        job_shell=JOB_SHELL,
    wildcard_constraints:
        solvent="|".join(SOLVENTS),
        variant="|".join(VARIANTS),
        temperature=_TEMP_WC,
        seed=_SEED_WC,
    resources:
        gpu=lambda wildcards: int(slurm_value(CFG, "gpu", 1)),
        charmm_slot=1,
        runtime=lambda wildcards: job_runtime_min(CFG, "umbrella_sol", variant=wildcards.variant),
        nodes=lambda wildcards: int(slurm_value(CFG, "nodes", 1)),
        tasks=lambda wildcards: int(slurm_value(CFG, "ntasks", 1)),
        cpus_per_task=lambda wildcards: int(slurm_value(CFG, "cpus_per_task", 4)),
        mem_mb_per_cpu=lambda wildcards: int(slurm_value(CFG, "mem_mb_per_cpu", 4000)),
        slurm_partition=lambda wildcards: str(slurm_value(CFG, "partition", "gpu")),
        slurm_extra=_slurm_extra,
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.out}
        bash {params.job_shell} \
          --job umbrella_sol \
          --solvent {wildcards.solvent} \
          --variant {wildcards.variant} \
          --temperature {wildcards.temperature} \
          --seed {wildcards.seed} \
          --output-dir {params.out} \
          --status {output.status} \
          > {log} 2>&1
        """


