rule dmc:
    input:
        _deps(
            f"{ARTIFACT_ROOT}/endpoints/status.json" if enabled(CFG, "endpoints") else None,
        ),
    output:
        status=f"{ARTIFACT_ROOT}/dmc/{{basin}}/status.json",
    log:
        f"{ARTIFACT_ROOT}/dmc/{{basin}}/stdout.log",
    params:
        cfg=_CFG_PATH,
        repo=str(REPO_ROOT),
        out=f"{ARTIFACT_ROOT}/dmc/{{basin}}",
    wildcard_constraints:
        basin="|".join(BASINS) if BASINS else "react|product",
    resources:
        gpu=lambda wildcards: int(slurm_value(CFG, "gpu", 1)),
        charmm_slot=1,
        runtime=lambda wildcards: job_runtime_min(CFG, "dmc"),
        nodes=lambda wildcards: int(slurm_value(CFG, "nodes", 1)),
        tasks=lambda wildcards: int(slurm_value(CFG, "ntasks", 1)),
        cpus_per_task=lambda wildcards: int(slurm_value(CFG, "cpus_per_task", 4)),
        mem_mb_per_cpu=lambda wildcards: int(slurm_value(CFG, "mem_mb_per_cpu", 4000)),
        slurm_partition=lambda wildcards: str(slurm_value(CFG, "partition", "gpu")),
        slurm_extra=_slurm_extra,
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.out}
        python {workflow.basedir}/scripts/run_job.py \
          --config {params.cfg} \
          --repo-root {params.repo} \
          --job dmc \
          --basin {wildcards.basin} \
          --output-dir {params.out} \
          --status {output.status} \
          > {log} 2>&1
        """


rule umbrella_gas:
    input:
        _deps(
            f"{ARTIFACT_ROOT}/endpoints/status.json" if enabled(CFG, "endpoints") else None,
        ),
    output:
        status=f"{ARTIFACT_ROOT}/umbrella_gas/{{variant}}/status.json",
    log:
        f"{ARTIFACT_ROOT}/umbrella_gas/{{variant}}/stdout.log",
    params:
        cfg=_CFG_PATH,
        repo=str(REPO_ROOT),
        out=f"{ARTIFACT_ROOT}/umbrella_gas/{{variant}}",
    wildcard_constraints:
        variant="|".join(VARIANTS),
    resources:
        gpu=lambda wildcards: int(slurm_value(CFG, "gpu", 1)),
        charmm_slot=1,
        runtime=lambda wildcards: job_runtime_min(CFG, "umbrella_gas", variant=wildcards.variant),
        nodes=lambda wildcards: int(slurm_value(CFG, "nodes", 1)),
        tasks=lambda wildcards: int(slurm_value(CFG, "ntasks", 1)),
        cpus_per_task=lambda wildcards: int(slurm_value(CFG, "cpus_per_task", 4)),
        mem_mb_per_cpu=lambda wildcards: int(slurm_value(CFG, "mem_mb_per_cpu", 4000)),
        slurm_partition=lambda wildcards: str(slurm_value(CFG, "partition", "gpu")),
        slurm_extra=_slurm_extra,
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.out}
        python {workflow.basedir}/scripts/run_job.py \
          --config {params.cfg} \
          --repo-root {params.repo} \
          --job umbrella_gas \
          --variant {wildcards.variant} \
          --output-dir {params.out} \
          --status {output.status} \
          > {log} 2>&1
        """


