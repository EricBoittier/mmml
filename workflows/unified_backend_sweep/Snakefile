configfile: "config.yaml"

from pathlib import Path


WORKFLOW_DIR = Path(workflow.basedir)
REPO_ROOT = WORKFLOW_DIR.parents[1]
BACKENDS = list(config["backends"])
SEEDS = [str(seed) for seed in config["seeds"]]
# Separate results tree per config (e.g. results-cpu/ for config.cpu.yaml) so a
# CPU-partition run doesn't clash with an in-progress/completed GPU run's outputs.
RESULTS_ROOT = config.get("results_root", "results")


def slurm_value(name, default):
    return config.get("slurm", {}).get(name, default)


def backend_runtime_min(backend):
    return int(config["backends"][backend].get("runtime_min", slurm_value("runtime_min", 30)))


def _slurm_extra(wildcards) -> str:
    """SLURM flags not covered by standard Snakemake resources (no mem/tasks/cpus here)."""
    mail = str(slurm_value("mail_user", "") or "").strip()
    nodelist = str(slurm_value("nodelist", "") or "").strip()
    parts = []
    if mail:
        parts.append(f"--mail-user={mail} --mail-type=END,FAIL")
    if nodelist:
        parts.append(f"--nodelist={nodelist}")
    return " ".join(parts)


rule all:
    input:
        f"{RESULTS_ROOT}/summary.csv",
        f"{RESULTS_ROOT}/summary.md",


rule run_setting:
    output:
        status=f"{RESULTS_ROOT}/{{backend}}/seed_{{seed}}/status.json",
    log:
        stdout=f"{RESULTS_ROOT}/{{backend}}/seed_{{seed}}/stdout.log",
    params:
        workflow_dir=WORKFLOW_DIR,
        repo_root=REPO_ROOT,
    wildcard_constraints:
        backend="|".join(BACKENDS),
        seed="|".join(SEEDS),
    resources:
        # gpu=0 for CPU-only submissions (see config.cpu.yaml): this cluster's
        # mmml venv has no CUDA jaxlib, so jax already runs on CPU even on the
        # gpu partition -- a CPU-partition run is strictly a better use of the
        # shared GPU allocation, not a capability downgrade.
        gpu=lambda wildcards: int(slurm_value("gpu", 1)),
        # charmm_slot (not mpi) caps concurrent PyCHARMM-touching jobs on a node;
        # the Slurm plugin treats `mpi` as a real MPI job requiring tasks>1.
        charmm_slot=1,
        runtime=lambda wildcards: backend_runtime_min(wildcards.backend),
        nodes=lambda wildcards: int(slurm_value("nodes", 1)),
        tasks=lambda wildcards: int(slurm_value("ntasks", 1)),
        cpus_per_task=lambda wildcards: int(slurm_value("cpus_per_task", 4)),
        mem_mb_per_cpu=lambda wildcards: int(slurm_value("mem_mb_per_cpu", 2000)),
        slurm_partition=lambda wildcards: str(slurm_value("partition", "gpu")),
        slurm_extra=_slurm_extra,
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.status})
        python {params.workflow_dir}/scripts/run_setting.py \
          --workflow-config {params.workflow_dir}/config.yaml \
          --backend {wildcards.backend} \
          --seed {wildcards.seed} \
          --output-dir $(dirname {output.status}) \
          --repo-root {params.repo_root} \
          > {log.stdout} 2>&1
        test -s {output.status}
        """


rule collect:
    input:
        statuses=expand(
            f"{RESULTS_ROOT}/{{backend}}/seed_{{seed}}/status.json",
            backend=BACKENDS,
            seed=SEEDS,
        ),
    output:
        csv=f"{RESULTS_ROOT}/summary.csv",
        md=f"{RESULTS_ROOT}/summary.md",
    params:
        script=WORKFLOW_DIR / "scripts" / "collect_results.py",
    shell:
        "python {params.script} --csv {output.csv} --markdown {output.md} {input.statuses}"
