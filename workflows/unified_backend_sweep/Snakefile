configfile: "config.yaml"

from pathlib import Path


WORKFLOW_DIR = Path(workflow.basedir)
REPO_ROOT = WORKFLOW_DIR.parents[1]
BACKENDS = list(config["backends"])
SEEDS = [str(seed) for seed in config["seeds"]]


def slurm_value(name, default):
    return config.get("slurm", {}).get(name, default)


def backend_runtime_min(backend):
    return int(config["backends"][backend].get("runtime_min", slurm_value("runtime_min", 30)))


rule all:
    input:
        "results/summary.csv",
        "results/summary.md",


rule run_setting:
    output:
        status="results/{backend}/seed_{seed}/status.json",
    log:
        stdout="results/{backend}/seed_{seed}/stdout.log",
    params:
        workflow_dir=WORKFLOW_DIR,
        repo_root=REPO_ROOT,
    wildcard_constraints:
        backend="|".join(BACKENDS),
        seed="|".join(SEEDS),
    resources:
        gpu=1,
        runtime=lambda wildcards: backend_runtime_min(wildcards.backend),
        mem_mb=lambda wildcards: int(slurm_value("mem_mb", 8000)),
        cpus_per_task=lambda wildcards: int(slurm_value("cpus_per_task", 4)),
        slurm_partition=lambda wildcards: str(slurm_value("partition", "gpu")),
        slurm_gres=lambda wildcards: str(slurm_value("gres", "gpu:1")),
    shell:
        """
        set -euo pipefail
        mkdir -p $(dirname {output.status})
        python {params.workflow_dir}/scripts/run_setting.py \
          --workflow-config {params.workflow_dir}/config.yaml \
          --backend {wildcards.backend} \
          --seed {wildcards.seed} \
          --output-dir $(dirname {output.status}) \
          --repo-root {params.repo_root} \
          > {log.stdout} 2>&1
        test -s {output.status}
        """


rule collect:
    input:
        statuses=expand(
            "results/{backend}/seed_{seed}/status.json",
            backend=BACKENDS,
            seed=SEEDS,
        ),
    output:
        csv="results/summary.csv",
        md="results/summary.md",
    params:
        script=WORKFLOW_DIR / "scripts" / "collect_results.py",
    shell:
        "python {params.script} --csv {output.csv} --markdown {output.md} {input.statuses}"
